<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ardel.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ardel.Launcher.Views"
    xmlns:loc="using:Ardel.Launcher.Localization"
    Title="{loc:String Key=Brand_Name}">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="20,0,0,0">
            <TextBlock
                x:Name="AppTitleTextBlock"
                Text="{loc:String Key=Brand_Name}"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                FontSize="15"
                CharacterSpacing="20"
                Opacity="0.92" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            CompactPaneLength="64"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{loc:String Key=Nav_Download}" Tag="download" Margin="0,4,0,0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{loc:String Key=Nav_Instances}" Tag="instances">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{loc:String Key=Nav_Settings}" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <views:DownloadProgressFlyout
            x:Name="DownloadFlyout"
            Grid.RowSpan="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,28,28"
            Canvas.ZIndex="100"
            OpenDownloadRequested="DownloadFlyout_OpenDownloadRequested" />
    </Grid>
</Window>
