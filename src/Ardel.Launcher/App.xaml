<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Ardel.Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Ardel.Launcher.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="ArdelAccentColor">#2D8A5B</Color>
            <Color x:Key="ArdelAccentDarkColor">#1F6B45</Color>
            <SolidColorBrush x:Key="ArdelAccentBrush" Color="{StaticResource ArdelAccentColor}" />
            <SolidColorBrush x:Key="ArdelAccentDarkBrush" Color="{StaticResource ArdelAccentDarkColor}" />

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <converters:NullToBoolConverter x:Key="NullToBool" />

            <Style x:Key="ArdelPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="ArdelSectionCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Opacity" Value="0.62" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="LaunchButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="200" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
