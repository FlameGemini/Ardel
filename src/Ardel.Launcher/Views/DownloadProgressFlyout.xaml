<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ardel.Launcher.Views.DownloadProgressFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ardel.Launcher.Models"
    xmlns:loc="using:Ardel.Launcher.Localization">

    <Border
        x:Name="RootBorder"
        Width="340"
        MaxHeight="360"
        Padding="12,12,12,10"
        CornerRadius="8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Tapped="RootBorder_Tapped">

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="3"
                    Height="18"
                    CornerRadius="2"
                    VerticalAlignment="Center"
                    Background="{StaticResource ArdelAccentBrush}" />
                <TextBlock
                    x:Name="HeaderText"
                    Grid.Column="1"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="{loc:String Key=Download_FlyoutHeader}" />
                <FontIcon
                    Grid.Column="2"
                    Glyph="&#xE896;"
                    FontSize="14"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource ArdelAccentBrush}" />
            </Grid>

            <ListView
                x:Name="JobsList"
                Grid.Row="1"
                SelectionMode="None"
                IsItemClickEnabled="False"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadJob">
                        <Grid ColumnSpacing="8" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Text="{x:Bind VersionId}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Content="{loc:String Key=Action_Cancel}"
                                Padding="10,2"
                                MinHeight="26"
                                FontSize="11"
                                Command="{x:Bind CancelCommand}"
                                Visibility="{x:Bind CanCancel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Tapped="CancelButton_Tapped" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="{x:Bind StatusText, Mode=OneWay}"
                                FontSize="11"
                                Opacity="0.55"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <ProgressBar
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Height="3"
                                Minimum="0"
                                Maximum="100"
                                Value="{x:Bind ProgressValue, Mode=OneWay}"
                                IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
