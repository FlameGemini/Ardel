<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.ModpackContentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ardel.Launcher.Models"
    xmlns:loc="using:Ardel.Launcher.Localization"
    NavigationCacheMode="Disabled">

    <Grid Padding="40,24,40,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Click="BackButton_Click"
                Style="{StaticResource ArdelIconButtonStyle}"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{loc:String Key=Action_Back}">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="22"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="13"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock
                x:Name="EmptyText"
                Text="{loc:String Key=Modpack_ContentsEmpty}"
                Opacity="0.65"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <ListView
                x:Name="ContentsList"
                SelectionMode="None"
                IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="MinHeight" Value="64" />
                        <Setter Property="UseSystemFocusVisuals" Value="False" />
                        <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ModpackContentItem">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="48"
                                Height="48"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon
                                        Glyph="&#xE8B7;"
                                        FontSize="18"
                                        Opacity="0.45"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Image
                                        Stretch="UniformToFill"
                                        Source="{x:Bind IconImage}"
                                        Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind SourceLabel}"
                                    FontSize="12"
                                    Opacity="0.65" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    MinWidth="108"
                                    Padding="14,8"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Content="{x:Bind OpenSiteLabel}"
                                    Tag="{x:Bind}"
                                    Click="OpenSiteButton_Click"
                                    Visibility="{x:Bind CanOpenWeb, Converter={StaticResource BoolToVisibility}}" />
                                <Button
                                    MinWidth="108"
                                    Padding="14,8"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Content="{loc:String Key=Modpack_OpenInLauncher}"
                                    Tag="{x:Bind}"
                                    Click="OpenInLauncherButton_Click"
                                    Visibility="{x:Bind CanOpenInLauncher, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
