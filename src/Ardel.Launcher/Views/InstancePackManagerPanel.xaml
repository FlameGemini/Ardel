<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ardel.Launcher.Views.InstancePackManagerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ardel.Launcher.ViewModels"
    xmlns:loc="using:Ardel.Launcher.Localization">

    <Grid
        AllowDrop="True"
        DragOver="PacksContainer_DragOver"
        Drop="PacksContainer_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,8,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Manager.ShowFilterBar, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <RadioButton Content="{loc:String Key=InstanceSettings_ModFilterAll}" GroupName="{x:Bind Manager.FilterGroupName, Mode=OneWay}" Tag="0" Click="FilterRadio_Click" IsChecked="{x:Bind Manager.FilterIndex, Mode=OneWay, Converter={StaticResource EqualValueToBool}, ConverterParameter=0}" Style="{StaticResource ToggleButtonRadioButtonStyle}" />
                        <RadioButton Content="{x:Bind Manager.UpdatableFilterLabel, Mode=OneWay}" GroupName="{x:Bind Manager.FilterGroupName, Mode=OneWay}" Tag="1" Click="FilterRadio_Click" IsChecked="{x:Bind Manager.FilterIndex, Mode=OneWay, Converter={StaticResource EqualValueToBool}, ConverterParameter=1}" Style="{StaticResource ToggleButtonRadioButtonStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Command="{x:Bind Manager.SearchCatalogCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:String Key=Nav_Download}"
                        Width="36" Height="32" Padding="0" MinWidth="0">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                    </Button>
                    <Button
                        Command="{x:Bind Manager.RefreshListsCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:String Key=Action_Refresh}"
                        Width="36" Height="32" Padding="0" MinWidth="0">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button
                        Command="{x:Bind Manager.OpenFolderCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{loc:String Key=Action_OpenFolder}"
                        Width="36" Height="32" Padding="0" MinWidth="0">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Manager.ShowSelectionActions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Text="{x:Bind Manager.SelectedCountText, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.7" />
                        <Button
                            Command="{x:Bind Manager.DeleteSelectedCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="{loc:String Key=InstanceSettings_DeleteItem}"
                            Width="36" Height="32" Padding="0"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                        <Button
                            Command="{x:Bind Manager.ClearPackSelectionCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="{loc:String Key=Action_ClearSelection}"
                            Width="36" Height="32" Padding="0">
                            <FontIcon Glyph="&#xE8E6;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />
            <TextBlock
                Text="{x:Bind Manager.UpdateStatusText, Mode=OneWay}"
                FontSize="12"
                Opacity="0.6"
                Visibility="{x:Bind Manager.HasUpdateStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
                Text="{x:Bind HeaderHint, Mode=OneWay}"
                FontSize="12"
                Opacity="0.55"
                TextWrapping="Wrap"
                Visibility="{x:Bind HeaderHintVisibility, Mode=OneWay}" />
            <StackPanel Visibility="{x:Bind Manager.ShowRegularList, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel
                    Spacing="6"
                    Padding="8,12"
                    Visibility="{x:Bind Manager.IsListEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{x:Bind Manager.EmptyMessage, Mode=OneWay}"
                        FontSize="13"
                        Opacity="0.7"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{loc:String Key=InstanceSettings_EmptyDropHint}"
                        FontSize="12"
                        Opacity="0.5"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <ListView
            x:Name="PacksListView"
            Grid.Row="1"
            ItemsSource="{x:Bind Manager.Items, Mode=OneWay}"
            SelectionMode="None"
            Padding="0,0,8,8"
            Visibility="{x:Bind Manager.ShowRegularList, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="ManipulationMode" Value="None" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ResourceItem">
                    <Grid Padding="12,8" ColumnSpacing="12" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.ColumnSpan="3"
                            CornerRadius="8"
                            Background="{ThemeResource ArdelSoftAccentBrush}"
                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            IsHitTestVisible="False" />
                        <Border
                            Width="3"
                            Margin="0,4"
                            HorizontalAlignment="Left"
                            CornerRadius="2"
                            Background="{ThemeResource ArdelAccentBrush}"
                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            IsHitTestVisible="False" />
                        <Grid Grid.Column="0" Width="36" Height="36" IsHitTestVisible="False">
                            <Border Width="36" Height="36" CornerRadius="6" Background="Transparent">
                                <Image Source="{x:Bind IconImage, Mode=OneWay}" Width="36" Height="36" Stretch="UniformToFill" />
                            </Border>
                            <Border
                                Width="36"
                                Height="36"
                                CornerRadius="6"
                                Background="#99000000"
                                Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind FileName}" FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Command="{x:Bind OpenPageCommand}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="{loc:String Key=InstanceSettings_OpenWeb}">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                            </Button>
                            <Button Command="{x:Bind OpenItemFolderCommand}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="{loc:String Key=InstanceSettings_OpenItemFolder}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            </Button>
                            <Button Command="{x:Bind DeleteItemCommand}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ToolTipService.ToolTip="{loc:String Key=InstanceSettings_DeleteItem}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid
            Grid.Row="1"
            Padding="0,0,8,8"
            Visibility="{x:Bind Manager.ShowUpdatableList, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                Grid.Row="0"
                ItemsSource="{x:Bind Manager.Updatable, Mode=OneWay}"
                SelectionMode="None"
                Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModUpdateCandidate">
                        <Border
                            Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ArdelCardCornerRadius}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="Transparent">
                                    <Image Source="{x:Bind IconImage}" Width="40" Height="40" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind VersionChangeLabel}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="{loc:String Key=InstanceSettings_ModUpdateSelectAll}" Command="{x:Bind Manager.SelectAllUpdatableCommand, Mode=OneWay}" />
                <Button Grid.Column="1" Content="{loc:String Key=InstanceSettings_ModUpdateSelectNone}" Command="{x:Bind Manager.ClearUpdatableSelectionCommand, Mode=OneWay}" />
                <Button
                    Grid.Column="3"
                    Content="{loc:String Key=InstanceSettings_ModUpdateAction}"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="120"
                    Command="{x:Bind Manager.UpdateSelectedCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind Manager.CanUpdateSelected, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
