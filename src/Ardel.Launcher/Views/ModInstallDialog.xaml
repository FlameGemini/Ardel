<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ardel.Launcher.Views.ModInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ardel.Launcher.Models"
    xmlns:helpers="using:Ardel.Launcher.Helpers"
    xmlns:loc="using:Ardel.Launcher.Localization"
    MinWidth="420"
    MaxWidth="520">

    <Grid RowSpacing="12" Padding="4,4,4,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                x:Name="TitleText"
                FontSize="15"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="12"
                Opacity="0.65"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="PickInstanceHint"
                Text="{loc:String Key=Mod_InstallPickInstance}"
                FontSize="12"
                Opacity="0.75"
                Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel
            x:Name="DatapackTargetPanel"
            Grid.Row="1"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock Text="{loc:String Key=Catalog_DatapackTargetHeader}" FontSize="12" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton
                    x:Name="InstanceDatapackRadio"
                    Content="{loc:String Key=Catalog_DatapackTargetInstance}"
                    GroupName="DatapackTarget"
                    IsChecked="True"
                    Checked="DatapackTarget_Checked" />
                <RadioButton
                    x:Name="WorldDatapackRadio"
                    Content="{loc:String Key=Catalog_DatapackTargetWorld}"
                    GroupName="DatapackTarget"
                    Checked="DatapackTarget_Checked" />
            </StackPanel>
            <TextBlock
                x:Name="DatapackTargetHint"
                Text="{loc:String Key=Catalog_DatapackTargetInstanceHint}"
                FontSize="11"
                Opacity="0.6"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="2"
            Text="{loc:String Key=Mod_InstallNoCompatible}"
            FontSize="13"
            Opacity="0.6"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <Grid Grid.Row="3">
            <ListView
                x:Name="InstanceList"
                MaxHeight="300"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="InstanceList_ItemClick"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="helpers:ModInstanceGroup">
                                <Grid Margin="0,8,0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind Header}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Opacity="0.9" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="6,2"
                                        CornerRadius="3"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind PreferredBadgeVisibility}">
                                        <TextBlock
                                            Text="{loc:String Key=Mod_InstallPreferred}"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameVersionItem">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Id}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <Border
                                Grid.Column="1"
                                Padding="8,3"
                                CornerRadius="4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind KindLabel}" FontSize="11" Opacity="0.85" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="WorldPanel"
                Spacing="8"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="BackToInstances_Click" Padding="6,4" MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            <TextBlock Text="{loc:String Key=Action_Back}" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="WorldPanelTitle"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    x:Name="WorldEmptyText"
                    Text="{loc:String Key=Catalog_DatapackNoWorlds}"
                    FontSize="13"
                    Opacity="0.6"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="WorldList"
                    MaxHeight="240"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="WorldList_ItemClick"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="10,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Border
                x:Name="DependencyCheckOverlay"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Opacity="0.92"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock
                        x:Name="DependencyCheckText"
                        Text="{loc:String Key=Mod_InstallCheckingDeps}"
                        FontSize="13"
                        Opacity="0.75"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel
                x:Name="DependencyPromptPanel"
                Spacing="10"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="DependencyPromptBack_Click" Padding="6,4" MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            <TextBlock Text="{loc:String Key=Action_Back}" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="DependencyPromptTitle"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    x:Name="DependencyPromptBody"
                    FontSize="12"
                    Opacity="0.75"
                    TextWrapping="Wrap" />
                <ListView
                    x:Name="DependencyPromptList"
                    MaxHeight="180"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ModDependencyItem">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="28"
                                    Height="28"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill" Source="{x:Bind IconImage, Mode=OneWay}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Title}"
                                    FontSize="13"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind KindLabel, Mode=OneWay}"
                                    FontSize="11"
                                    Opacity="0.65"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Spacing="8">
                    <Button
                        x:Name="InstallAllDepsButton"
                        Click="InstallAllDepsButton_Click"
                        HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        x:Name="InstallModOnlyButton"
                        Click="InstallModOnlyButton_Click"
                        HorizontalAlignment="Stretch"
                        Content="{loc:String Key=Mod_InstallModOnly}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBox
            x:Name="FileNameBox"
            Grid.Row="4"
            Header="{loc:String Key=Mod_InstallFileName}"
            TextChanged="FileNameBox_TextChanged"
            MaxLength="180" />
    </Grid>
</UserControl>
