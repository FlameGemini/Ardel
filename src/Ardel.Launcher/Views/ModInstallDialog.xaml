<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ardel.Launcher.Views.ModInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ardel.Launcher.Models"
    xmlns:helpers="using:Ardel.Launcher.Helpers"
    xmlns:loc="using:Ardel.Launcher.Localization"
    MinWidth="420"
    MaxWidth="520">

    <Grid RowSpacing="12" Padding="4,4,4,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                x:Name="TitleText"
                FontSize="15"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="12"
                Opacity="0.65"
                TextWrapping="Wrap" />
            <TextBlock
                Text="{loc:String Key=Mod_InstallPickInstance}"
                FontSize="12"
                Opacity="0.75"
                Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Text="{loc:String Key=Mod_InstallNoCompatible}"
            FontSize="13"
            Opacity="0.6"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <ListView
            x:Name="InstanceList"
            Grid.Row="2"
            MaxHeight="300"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="InstanceList_ItemClick"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="helpers:ModInstanceGroup">
                            <Grid Margin="0,8,0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind Header}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Opacity="0.9" />
                                <Border
                                    Grid.Column="1"
                                    Padding="6,2"
                                    CornerRadius="3"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind PreferredBadgeVisibility}">
                                    <TextBlock
                                        Text="{loc:String Key=Mod_InstallPreferred}"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="10,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:GameVersionItem">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind Id}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Padding="8,3"
                            CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind KindLabel}" FontSize="11" Opacity="0.85" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBox
            x:Name="FileNameBox"
            Grid.Row="3"
            Header="{loc:String Key=Mod_InstallFileName}"
            TextChanged="FileNameBox_TextChanged"
            MaxLength="180" />
    </Grid>
</UserControl>
