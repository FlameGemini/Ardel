<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Ardel.Launcher.Localization"
    NavigationCacheMode="Disabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="64,48">
        <StackPanel MaxWidth="640" Spacing="28">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:String Key=About_Title}" Style="{StaticResource ArdelPageTitleStyle}" />
                <TextBlock
                    Text="{x:Bind VersionText}"
                    FontSize="13"
                    Opacity="0.55"
                    FontFamily="Consolas" />
                <TextBlock
                    Text="{loc:String Key=About_Subtitle}"
                    Style="{StaticResource ArdelSectionCaptionStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="{loc:String Key=About_CreditsHeading}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="{loc:String Key=About_CreditsIntro}"
                    FontSize="12"
                    Opacity="0.65"
                    TextWrapping="Wrap" />

                <StackPanel Spacing="14" Margin="0,6,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="CmlLib.Core" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:String Key=About_Credit_CmlLib}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="CmlLib.Core.Installer.Forge / NeoForge" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:String Key=About_Credit_CmlLibForge}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Optifine.Installer" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:String Key=About_Credit_OptifineInstaller}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="CommunityToolkit.Mvvm" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:String Key=About_Credit_CommunityToolkit}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="authlib-injector" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:String Key=About_Credit_AuthlibInjector}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="BMCLAPI" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:String Key=About_Credit_BmclApi}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock
                Text="{loc:String Key=About_Disclaimer}"
                FontSize="11"
                Opacity="0.45"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
