<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ardel.Launcher.Views.AddSkinDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Ardel.Launcher.Localization"
    MinWidth="440"
    MaxWidth="520">

    <StackPanel Spacing="14" Padding="4,4,4,8">
        <StackPanel x:Name="LibrarySwitch" Spacing="8">
            <TextBlock Text="{loc:String Key=Account_Type}" FontSize="12" Opacity="0.7" />
            <RadioButton
                x:Name="OfflineLibRadio"
                Content="{loc:String Key=Account_KindOffline}"
                GroupName="SkinLibraryKind"
                IsChecked="True"
                Checked="LibraryKind_Changed" />
            <RadioButton
                x:Name="MicrosoftLibRadio"
                Content="{loc:String Key=Account_KindMicrosoft}"
                GroupName="SkinLibraryKind"
                Checked="LibraryKind_Changed" />
        </StackPanel>

        <TextBox
            x:Name="NameBox"
            Header="{loc:String Key=Skin_Name}"
            PlaceholderText="{loc:String Key=Skin_NamePlaceholder}"
            MaxLength="48" />

        <StackPanel Spacing="6">
            <TextBlock Text="{loc:String Key=Skin_ArmModel}" FontSize="12" Opacity="0.7" />
            <RadioButton
                x:Name="ClassicRadio"
                Content="{loc:String Key=Skin_ModelSteve}"
                GroupName="ArmModel"
                IsChecked="True" />
            <RadioButton
                x:Name="SlimRadio"
                Content="{loc:String Key=Skin_ModelAlex}"
                GroupName="ArmModel" />
        </StackPanel>

        <StackPanel Spacing="8">
            <Button
                x:Name="ImportButton"
                Content="{loc:String Key=Skin_Import}"
                Click="ImportButton_Click"
                HorizontalAlignment="Left" />
            <TextBlock
                x:Name="PathText"
                FontSize="12"
                Opacity="0.6"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            x:Name="ErrorText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            FontSize="12"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
