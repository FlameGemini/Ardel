<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ardel.Launcher.Models"
    xmlns:loc="using:Ardel.Launcher.Localization"
    NavigationCacheMode="Disabled">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="148" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Secondary menu: labels stay Minecraft / Mod in every language. -->
        <Border
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Padding="16,28,12,24"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ListView
                x:Name="SectionList"
                SelectionMode="Single"
                IsItemClickEnabled="False"
                SelectedIndex="0"
                SelectionChanged="SectionList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListViewItem Content="Minecraft" Tag="minecraft" />
                <ListViewItem Content="Mod" Tag="mod" />
            </ListView>
        </Border>

        <Grid
            Grid.Column="1"
            Padding="28,28,40,24"
            Visibility="{x:Bind ViewModel.IsMinecraftSection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Header="{loc:String Key=Download_Type}"
                    ItemsSource="{x:Bind ViewModel.CategoryOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                    DisplayMemberPath="Name"
                    HorizontalAlignment="Stretch" />

                <TextBox
                    Grid.Column="1"
                    Header="{loc:String Key=Download_Search}"
                    PlaceholderText="{loc:String Key=Download_SearchPlaceholder}"
                    Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="2"
                    Content="{loc:String Key=Action_Refresh}"
                    VerticalAlignment="Bottom"
                    MinHeight="40"
                    Command="{x:Bind ViewModel.LoadCommand}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <ListView
                    x:Name="VersionList"
                    ItemsSource="{x:Bind ViewModel.FilteredVersions, Mode=OneWay}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="VersionList_ItemClick"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ShowsScrollingPlaceholders="True"
                    Opacity="0">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="12,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameVersionItem">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind Id}"
                                    FontSize="15"
                                    VerticalAlignment="Center" />
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Padding="8,3"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock
                                        Text="{x:Bind JavaRequirementLabel}"
                                        FontSize="12"
                                        Opacity="0.8" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing
                    x:Name="VersionLoadingRing"
                    Width="36"
                    Height="36"
                    IsActive="{x:Bind ViewModel.IsLoadingVersions, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingVersions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="2" Spacing="6" Margin="0,4,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind ViewModel.GameDirectory, Mode=OneWay}"
                        Opacity="0.55"
                        FontSize="12"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                    <HyperlinkButton
                        Grid.Column="1"
                        Content="{loc:String Key=Action_OpenFolder}"
                        Padding="8,0"
                        Command="{x:Bind ViewModel.OpenGameDirectoryCommand}" />
                </Grid>
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Opacity="0.7"
                    FontSize="13"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Column="1"
            Padding="28,28,40,24"
            Visibility="{x:Bind ViewModel.IsModSection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="12">
                <TextBox
                    Header="{loc:String Key=Mod_Keyword}"
                    PlaceholderText="{loc:String Key=Mod_KeywordPlaceholder}"
                    Text="{x:Bind ViewModel.ModSearch.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Header="{loc:String Key=Mod_Source}"
                        ItemsSource="{x:Bind ViewModel.ModSearch.SourceOptions}"
                        SelectedItem="{x:Bind ViewModel.ModSearch.SelectedSource, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        HorizontalAlignment="Stretch" />

                    <ComboBox
                        x:Name="ModVersionCombo"
                        Grid.Column="1"
                        Header="{loc:String Key=Mod_Version}"
                        ItemsSource="{x:Bind ViewModel.ModSearch.VersionOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.ModSearch.SelectedVersion, Mode=OneWay}"
                        DisplayMemberPath="Name"
                        IsEditable="True"
                        Text="{x:Bind ViewModel.ModSearch.VersionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Stretch" />

                    <ComboBox
                        Grid.Column="2"
                        Header="{loc:String Key=Mod_Category}"
                        ItemsSource="{x:Bind ViewModel.ModSearch.CategoryOptions}"
                        SelectedItem="{x:Bind ViewModel.ModSearch.SelectedCategory, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        HorizontalAlignment="Stretch" />
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Header="{loc:String Key=Mod_Loader}"
                        ItemsSource="{x:Bind ViewModel.ModSearch.LoaderOptions}"
                        SelectedItem="{x:Bind ViewModel.ModSearch.SelectedLoader, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.ModSearch.IsLoaderFilterVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <Button
                        Grid.Column="1"
                        Content="{loc:String Key=Action_Search}"
                        MinWidth="120"
                        MinHeight="40"
                        VerticalAlignment="Bottom"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="ModSearchButton_Click" />

                    <Button
                        Grid.Column="2"
                        Content="{loc:String Key=Action_Reset}"
                        MinWidth="120"
                        MinHeight="40"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.ModSearch.ResetCommand}" />
                </Grid>

                <TextBlock
                    Text="{x:Bind ViewModel.ModSearch.LiteLoaderHintText, Mode=OneWay}"
                    Opacity="0.75"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ModSearch.IsLiteLoaderUnsupported, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Results -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView
                    ItemsSource="{x:Bind ViewModel.ModSearch.Results, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    ShowsScrollingPlaceholders="True"
                    Visibility="{x:Bind ViewModel.ModSearch.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="72" />
                            <Setter Property="Padding" Value="12,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ModProjectItem">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="48"
                                    Height="48"
                                    CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    VerticalAlignment="Top">
                                    <Image
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Image.Source>
                                            <BitmapImage
                                                UriSource="{x:Bind IconUri, Mode=OneWay}"
                                                DecodePixelWidth="64"
                                                DecodePixelHeight="64"
                                                DecodePixelType="Logical" />
                                        </Image.Source>
                                    </Image>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Opacity="0.7" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock
                                            Text="{x:Bind VersionsLabel}"
                                            FontSize="11"
                                            Opacity="0.6"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasVersions, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Text="{x:Bind LoadersLabel}"
                                            FontSize="11"
                                            Opacity="0.6"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasLoaders, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Padding="8,3" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind SourceLabel}" FontSize="12" Opacity="0.85" />
                                    </Border>
                                    <TextBlock Text="{x:Bind DownloadsLabel}" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing
                    Width="36"
                    Height="36"
                    IsActive="{x:Bind ViewModel.ModSearch.IsSearching, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ModSearch.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <StackPanel
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.ModSearch.IsPagerVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Button
                        MinWidth="100"
                        MinHeight="36"
                        Content="{loc:String Key=Mod_PagePrevious}"
                        Command="{x:Bind ViewModel.ModSearch.PreviousPageCommand}"
                        IsEnabled="{x:Bind ViewModel.ModSearch.CanGoPrevious, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ModSearch.PageLabel, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Opacity="0.75"
                        FontSize="13" />
                    <Button
                        MinWidth="100"
                        MinHeight="36"
                        Content="{loc:String Key=Mod_PageNext}"
                        Command="{x:Bind ViewModel.ModSearch.NextPageCommand}"
                        IsEnabled="{x:Bind ViewModel.ModSearch.CanGoNext, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="2"
                Margin="0,10,0,0"
                Text="{x:Bind ViewModel.ModSearch.StatusText, Mode=OneWay}"
                Opacity="0.7"
                FontSize="13"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
