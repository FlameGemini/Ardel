<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ardel.Launcher.Views.ModpackInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Ardel.Launcher.Localization"
    MinWidth="400"
    MaxWidth="480">

    <StackPanel Spacing="12" Padding="4,4,4,8">
        <StackPanel Spacing="4">
            <TextBlock
                x:Name="TitleText"
                FontSize="15"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="12"
                Opacity="0.65"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBox
            x:Name="InstanceNameBox"
            Header="{loc:String Key=Modpack_InstanceName}"
            PlaceholderText="{loc:String Key=Modpack_InstanceNamePlaceholder}" />

        <TextBlock
            x:Name="ValidationText"
            FontSize="12"
            Opacity="0.75"
            TextWrapping="Wrap"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

        <TextBlock
            Text="{loc:String Key=Modpack_InstallHint}"
            FontSize="12"
            Opacity="0.6"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
