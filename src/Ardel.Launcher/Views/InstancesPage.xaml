<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.InstancesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ardel.Launcher.Models"
    xmlns:loc="using:Ardel.Launcher.Localization"
    NavigationCacheMode="Disabled">

    <Grid Padding="40,28,40,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{loc:String Key=Instances_Title}"
                Style="{StaticResource ArdelPageTitleStyle}"
                Margin="0" />
            <Button
                Grid.Column="1"
                Content="{loc:String Key=Action_Refresh}"
                VerticalAlignment="Center"
                MinHeight="36"
                Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <TextBlock
            Grid.Row="1"
            Text="{loc:String Key=Instances_Subtitle}"
            Style="{StaticResource ArdelSectionCaptionStyle}"
            Margin="0,4,0,8" />

        <Grid Grid.Row="2">
            <ListView
                ItemsSource="{x:Bind ViewModel.Instances, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ShowsScrollingPlaceholders="False">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="56" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameVersionItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="{x:Bind Id}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />

                            <Border
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Padding="10,4"
                                CornerRadius="4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock
                                    Text="{x:Bind KindLabel}"
                                    FontSize="12"
                                    Opacity="0.85" />
                            </Border>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <Button
                                    ToolTipService.ToolTip="{loc:String Key=Action_Launch}"
                                    Tag="{x:Bind}"
                                    Click="LaunchButton_Click"
                                    Width="40"
                                    Height="36"
                                    Padding="0">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                </Button>
                                <Button
                                    ToolTipService.ToolTip="{loc:String Key=Instances_OpenSettings}"
                                    Tag="{x:Bind}"
                                    Click="OpenFolderButton_Click"
                                    Width="40"
                                    Height="36"
                                    Padding="0">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                </Button>
                                <Button
                                    ToolTipService.ToolTip="{loc:String Key=Action_Delete}"
                                    Tag="{x:Bind}"
                                    Click="DeleteButton_Click"
                                    Width="40"
                                    Height="36"
                                    Padding="0">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Text="{loc:String Key=Instances_Empty}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.5"
                FontSize="14"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <StackPanel Grid.Row="3" Spacing="10" Margin="0,12,0,0">
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Opacity="0.9"
                FontSize="15"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <ProgressBar
                Minimum="0"
                Maximum="100"
                Height="8"
                Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Page>
