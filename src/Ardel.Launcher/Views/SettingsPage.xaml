<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.SettingsPage"
    x:Name="SettingsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ardel.Launcher.Models"
    xmlns:viewmodels="using:Ardel.Launcher.ViewModels"
    xmlns:loc="using:Ardel.Launcher.Localization"
    xmlns:converters="using:Ardel.Launcher.Converters"
    xmlns:views="using:Ardel.Launcher.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToThemeBrushConverter
            x:Key="LanguageCardBackgroundConverter"
            FalseResourceKey="CardBackgroundFillColorDefaultBrush"
            TrueResourceKey="ArdelSelectedBrush" />
        <converters:BoolToThemeBrushConverter
            x:Key="LanguageCardBorderConverter"
            FalseResourceKey="CardStrokeColorDefaultBrush"
            TrueResourceKey="ArdelAccentBrush" />
        <converters:BoolToThemeBrushConverter
            x:Key="LanguageLabelForegroundConverter"
            FalseResourceKey="ArdelInkBrush"
            TrueResourceKey="ArdelAccentBrush" />
        <Style x:Key="SettingsDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="AboutHeroCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
            <Setter Property="Padding" Value="28,26" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <DataTemplate x:Key="AboutLegalSectionTemplate" x:DataType="models:AboutLegalSection">
            <Expander
                Header="{x:Bind Title}"
                IsExpanded="False"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Margin="0,0,0,6">
                <TextBlock
                    Text="{x:Bind Body}"
                    FontSize="12"
                    Opacity="0.58"
                    TextWrapping="Wrap"
                    LineHeight="20"
                    IsTextSelectionEnabled="True" />
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="AboutCreditGroupTemplate" x:DataType="models:AboutCreditGroup">
            <Expander
                Header="{x:Bind Heading}"
                IsExpanded="False"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Margin="0,2,0,0">
                <ItemsControl
                    ItemsSource="{x:Bind Items}"
                    ItemTemplate="{StaticResource AboutCreditCompactTemplate}" />
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="AboutCreditCompactTemplate" x:DataType="models:AboutCreditItem">
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="0"
                MinHeight="0"
                Background="Transparent"
                BorderThickness="0"
                Click="CreditButton_Click"
                Tag="{x:Bind}"
                IsEnabled="{x:Bind HasUrl}"
                ToolTipService.ToolTip="{loc:String Key=About_OpenLink}">
                <Grid Padding="0,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="{x:Bind Name}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <Border
                                Padding="6,1"
                                CornerRadius="4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind HasLicense, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Bind License}" FontSize="10" Opacity="0.72" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind Summary}"
                            FontSize="12"
                            Opacity="0.52"
                            TextWrapping="Wrap"
                            LineHeight="17" />
                    </StackPanel>
                    <FontIcon
                        Grid.Column="1"
                        Glyph="&#xE8A7;"
                        FontSize="11"
                        Opacity="0.35"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind HasUrl, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="LanguageRowIconSlotStyle" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{ThemeResource ArdelSoftAccentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsCardIconStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource ArdelSoftAccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsNavCardStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        </Style>

        <Style x:Key="SettingsSectionTabStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="2,0,2,10" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" MinHeight="32">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="LabelText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="LabelText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="LabelText.FontWeight" Value="SemiBold" />
                                            <Setter Target="Indicator.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="Indicator.Opacity" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel x:Name="RootGrid" Spacing="8">
                                <ContentPresenter
                                    x:Name="LabelText"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}" />
                                <Border
                                    x:Name="Indicator"
                                    Height="2"
                                    CornerRadius="1"
                                    HorizontalAlignment="Stretch"
                                    Background="{ThemeResource ArdelAccentBrush}"
                                    Opacity="0" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="40,28,40,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:String Key=Settings_Title}" Style="{StaticResource ArdelPageTitleStyle}" Margin="0" />
                <TextBlock Text="{loc:String Key=Settings_Subtitle}" Style="{StaticResource ArdelSectionCaptionStyle}" Margin="0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="DefaultsTab"
                        GroupName="SettingsSection"
                        Tag="defaults"
                        Style="{StaticResource SettingsSectionTabStyle}"
                        Click="SectionTab_Click"
                        Content="{loc:String Key=Settings_SectionDefaults}" />
                    <RadioButton
                        x:Name="AppearanceTab"
                        GroupName="SettingsSection"
                        Tag="appearance"
                        Style="{StaticResource SettingsSectionTabStyle}"
                        Click="SectionTab_Click"
                        Content="{loc:String Key=Settings_SectionAppearance}" />
                    <RadioButton
                        x:Name="AboutTab"
                        GroupName="SettingsSection"
                        Tag="about"
                        Style="{StaticResource SettingsSectionTabStyle}"
                        Click="SectionTab_Click"
                        Content="{loc:String Key=Settings_SectionAbout}" />
                </StackPanel>
                <Rectangle Style="{StaticResource SettingsDividerStyle}" Margin="0" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer
            x:Name="SettingsScrollViewer"
            Grid.Row="1"
            MaxWidth="640"
            HorizontalAlignment="Left"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Padding="0,0,8,0"
            BringIntoViewOnFocusChange="False">
            <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                <TextBlock
                    Text="{x:Bind ViewModel.SectionDescription, Mode=OneWay}"
                    Style="{StaticResource ArdelSectionCaptionStyle}"
                    Margin="0"
                    TextWrapping="Wrap" />

                <StackPanel
                    x:Name="AppearanceSectionHost"
                    Spacing="12"
                    x:Load="False"
                    Visibility="{x:Bind ViewModel.IsAppearanceSection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid x:Name="AppearanceContentRoot" HorizontalAlignment="Stretch">
                        <StackPanel
                            x:Name="AppearanceHubPanel"
                            Spacing="12"
                            HorizontalAlignment="Stretch">

                            <Button Style="{StaticResource SettingsNavCardStyle}" Command="{x:Bind ViewModel.OpenPersonalizationTopicCommand}" CommandParameter="language">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsCardIconStyle}">
                                        <FontIcon Glyph="&#xE128;" FontSize="16" Foreground="{ThemeResource ArdelAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:String Key=Settings_Language}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SettingsNavCardStyle}" Command="{x:Bind ViewModel.OpenPersonalizationTopicCommand}" CommandParameter="theme">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsCardIconStyle}">
                                        <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource ArdelAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:String Key=Settings_Theme}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SettingsNavCardStyle}" Command="{x:Bind ViewModel.OpenPersonalizationTopicCommand}" CommandParameter="splash">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsCardIconStyle}">
                                        <FontIcon Glyph="&#xE771;" FontSize="16" Foreground="{ThemeResource ArdelAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:String Key=Settings_StartupSplash}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SettingsNavCardStyle}" Command="{x:Bind ViewModel.OpenPersonalizationTopicCommand}" CommandParameter="quicklaunch">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsCardIconStyle}">
                                        <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="{ThemeResource ArdelAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:String Key=Settings_QuickLaunch}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SettingsNavCardStyle}" Command="{x:Bind ViewModel.OpenPersonalizationTopicCommand}" CommandParameter="homewidgets">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsCardIconStyle}">
                                        <FontIcon Glyph="&#xE9CA;" FontSize="16" Foreground="{ThemeResource ArdelAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:String Key=Settings_HomeWidgets}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel
                            x:Name="AppearanceDetailPanel"
                            Spacing="16"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed"
                            Opacity="0"
                            IsHitTestVisible="False">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Padding="8,6"
                                    MinWidth="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.ClosePersonalizationTopicCommand}"
                                    ToolTipService.ToolTip="{loc:String Key=Action_Back}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE76B;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:String Key=Action_Back}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    Text="{x:Bind ViewModel.PersonalizationDetailTitle, Mode=OneWay}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel
                                Spacing="12"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.IsPersonalizationLanguage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:String Key=Settings_LanguageRestartHint}" Style="{StaticResource SettingsHintStyle}" />
                                <ListView
                                    x:Name="LanguageOptionsList"
                                    ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                                    SelectionMode="None"
                                    IsItemClickEnabled="True"
                                    ItemClick="LanguageListView_ItemClick"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="UseSystemFocusVisuals" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <ListViewItemPresenter
                                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            Padding="{TemplateBinding Padding}"
                                                            SelectionCheckMarkVisualEnabled="False"
                                                            PointerOverBackground="Transparent"
                                                            PressedBackground="Transparent"
                                                            SelectedBackground="Transparent"
                                                            SelectedPointerOverBackground="Transparent"
                                                            SelectedPressedBackground="Transparent" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:LanguageOption">
                                            <Border
                                                HorizontalAlignment="Stretch"
                                                Padding="16,14"
                                                CornerRadius="10"
                                                Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource LanguageCardBackgroundConverter}}"
                                                BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource LanguageCardBorderConverter}}"
                                                BorderThickness="1">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="56" Height="28" VerticalAlignment="Center">
                                                        <Border
                                                            Style="{StaticResource LanguageRowIconSlotStyle}"
                                                            Visibility="{x:Bind IsSystemLanguage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                            <FontIcon
                                                                Glyph="&#xE772;"
                                                                FontSize="14"
                                                                Foreground="{ThemeResource ArdelAccentBrush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border
                                                            Style="{StaticResource LanguageRowIconSlotStyle}"
                                                            Visibility="{x:Bind CodeBadgeVisibility, Mode=OneWay}">
                                                            <TextBlock
                                                                Text="{x:Bind CodeBadgeText}"
                                                                FontFamily="Consolas"
                                                                FontSize="10.5"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource ArdelAccentBrush}"
                                                                TextAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind Label}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource LanguageLabelForegroundConverter}}"
                                                        VerticalAlignment="Center" />
                                                    <FontIcon
                                                        Grid.Column="2"
                                                        Glyph="&#xE73E;"
                                                        FontSize="14"
                                                        Foreground="{ThemeResource ArdelAccentBrush}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind SelectedBadgeVisibility, Mode=OneWay}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    MinHeight="0"
                                    Margin="8,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Opacity="0.35"
                                    Command="{x:Bind ViewModel.RerunSetupWizardCommand}">
                                    <TextBlock
                                        Text="{loc:String Key=About_RerunSetup}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </StackPanel>

                            <Border Style="{StaticResource SettingsCardStyle}" Visibility="{x:Bind ViewModel.IsPersonalizationTheme, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedThemeDescription, Mode=OneWay}" Style="{StaticResource SettingsHintStyle}" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MinItemWidth="148"
                                                MinItemHeight="118"
                                                MinColumnSpacing="10"
                                                MinRowSpacing="10"
                                                ItemsJustification="Start"
                                                ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:ThemeOption">
                                                <Button
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    CornerRadius="8"
                                                    Background="{x:Bind ThemeChipBackground}"
                                                    BorderBrush="{x:Bind ThemeChipBorderBrush}"
                                                    BorderThickness="{x:Bind ThemeChipBorderThickness}"
                                                    Click="ThemeButton_Click"
                                                    Tag="{x:Bind Code}"
                                                    ToolTipService.ToolTip="{x:Bind Description}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border
                                                            Margin="6,6,6,0"
                                                            Height="72"
                                                            CornerRadius="6"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="12" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <Border Background="{x:Bind PreviewChromeBrush}" />
                                                                <Grid Grid.Row="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="22" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{x:Bind PreviewRailBrush}" />
                                                                    <Border Grid.Column="1" Background="{x:Bind PreviewCanvasBrush}">
                                                                        <Border
                                                                            Width="36"
                                                                            Height="8"
                                                                            Margin="8,10,0,0"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            CornerRadius="4"
                                                                            Background="{x:Bind PreviewBrush}"
                                                                            Visibility="{x:Bind ColorCircleVisibility}" />
                                                                    </Border>
                                                                </Grid>
                                                                <FontIcon
                                                                    Grid.RowSpan="2"
                                                                    Glyph="&#xE770;"
                                                                    FontSize="18"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Visibility="{x:Bind DefaultIconVisibility}" />
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Text="{x:Bind Label}"
                                                            Margin="10,8,10,10"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{x:Bind ThemeLabelBrush}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}" Visibility="{x:Bind ViewModel.IsPersonalizationStartupSplash, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{loc:String Key=Settings_StartupSplashDesc}" Style="{StaticResource SettingsHintStyle}" />

                                    <Grid ColumnSpacing="16">
