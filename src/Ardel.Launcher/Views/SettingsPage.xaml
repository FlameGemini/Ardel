                                    </Grid>
                                    <Slider Minimum="1" Maximum="256" StepFrequency="1" Value="{x:Bind ViewModel.ResourceRepairConcurrency, Mode=TwoWay}" />
                                    <TextBlock Text="{loc:String Key=Settings_ResourceVerifyMode}" Opacity="0.75" />
                                    <ComboBox
                                        x:Name="ResourceVerifyModeCombo"
                                        HorizontalAlignment="Stretch"
                                        SelectedIndex="{x:Bind ViewModel.ResourceVerifyMode, Mode=OneWay}"
                                        SelectionChanged="ResourceVerifyModeCombo_SelectionChanged">
                                        <ComboBoxItem Content="{loc:String Key=Settings_ResourceVerifyTrustReady}" />
                                        <ComboBoxItem Content="{loc:String Key=Settings_ResourceVerifyQuick}" />
                                        <ComboBoxItem Content="{loc:String Key=Settings_ResourceVerifyFull}" />
                                    </ComboBox>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:String Key=Settings_ResourceRepairAutoDownload}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ResourceRepairAutoDownload, Mode=TwoWay}" OffContent="{loc:String Key=Settings_Off}" OnContent="{loc:String Key=Settings_On}" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:String Key=Settings_ResourceRepairWriteReady}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ResourceRepairWriteReadyMarker, Mode=TwoWay}" OffContent="{loc:String Key=Settings_Off}" OnContent="{loc:String Key=Settings_On}" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:String Key=Settings_ResourceRepairBlockLaunch}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ResourceRepairBlockLaunchOnFailure, Mode=TwoWay}" OffContent="{loc:String Key=Settings_Off}" OnContent="{loc:String Key=Settings_On}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}" Visibility="{x:Bind ViewModel.IsDefaultsCrashAnalysis, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{loc:String Key=Settings_CrashAnalysisHint}" Style="{StaticResource SettingsHintStyle}" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:String Key=Settings_CrashAnalysisEnabled}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CrashAnalysisEnabled, Mode=TwoWay}" OffContent="{loc:String Key=Settings_Off}" OnContent="{loc:String Key=Settings_On}" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:String Key=Settings_CrashAnalysisOnForceKill}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CrashAnalysisOnForceKill, Mode=TwoWay}" OffContent="{loc:String Key=Settings_Off}" OnContent="{loc:String Key=Settings_On}" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:String Key=Settings_CrashAnalysisAutoOpenLogs}" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CrashAnalysisAutoOpenLogs, Mode=TwoWay}" OffContent="{loc:String Key=Settings_Off}" OnContent="{loc:String Key=Settings_On}" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:String Key=Settings_CrashAnalysisVerbose}" VerticalAlignment="Center" Opacity="0.7" />
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CrashAnalysisVerboseDebug, Mode=TwoWay}" OffContent="{loc:String Key=Settings_Off}" OnContent="{loc:String Key=Settings_On}" />
                                    </Grid>

                                    <Border
                                        Margin="0,8,0,0"
                                        Padding="12,10"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                Text="{loc:String Key=Settings_DialogDebugDevLabel}"
                                                FontSize="11"
                                                Opacity="0.55"
                                                FontFamily="Consolas" />
                                            <HyperlinkButton
                                                Content="{loc:String Key=Settings_DialogDebugEntry}"
                                                Command="{x:Bind ViewModel.OpenDefaultsTopicCommand}"
                                                CommandParameter="debug"
                                                Padding="0"
                                                FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Visibility="{x:Bind ViewModel.IsDefaultsDialogDebug, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <views:DialogDebugPanel />
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel
                    x:Name="AboutContentRoot"
                    Spacing="16"
                    x:Load="False"
                    Visibility="{x:Bind ViewModel.IsAboutSection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                    <!-- Hero -->
                    <Border Style="{StaticResource AboutHeroCardStyle}">
                        <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <Image
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    Source="{x:Bind About.BrandLogoImage, Mode=OneWay}" />
                                <StackPanel Spacing="6" HorizontalAlignment="Center" MaxWidth="420">
                                    <TextBlock
                                        Text="{loc:String Key=Brand_Name}"
                                        FontSize="26"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Bind About.Subtitle, Mode=OneWay}"
                                        FontSize="13"
                                        Opacity="0.58"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        LineHeight="19" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center">
                                <Button
                                    Padding="10,5"
                                    MinHeight="0"
                                    MinWidth="0"
                                    CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="{loc:String Key=About_CopyVersion}"
                                    Command="{x:Bind About.CopyVersionCommand}">
                                    <TextBlock
                                        Text="{x:Bind About.VersionLabel, Mode=OneWay}"
                                        FontSize="12"
                                        FontFamily="{StaticResource ArdelBodyFont}"
                                        Opacity="0.85" />
                                </Button>
                                <TextBlock
                                    Text="{x:Bind About.CopyrightLabel, Mode=OneWay}"
                                    FontSize="11"
                                    Opacity="0.42"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center">
                                <Button
                                    MinHeight="36"
                                    Padding="16,0"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    BorderThickness="0"
                                    Command="{x:Bind About.OpenSourceCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                                        <TextBlock Text="{loc:String Key=About_SourceLink}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    MinHeight="36"
                                    Padding="16,0"
                                    Command="{x:Bind About.OpenLicenseCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="13" Opacity="0.75" />
                                        <TextBlock Text="{loc:String Key=About_LicenseId}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock
                                Text="{loc:String Key=About_License}"
                                FontSize="12"
                                Opacity="0.48"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                LineHeight="18"
                                MaxWidth="480"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Credits -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:String Key=About_CreditsHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{loc:String Key=About_CreditsIntro}"
                                FontSize="12"
                                Opacity="0.52"
                                TextWrapping="Wrap"
                                Margin="0,0,0,8" />
                            <ItemsControl
                                ItemsSource="{x:Bind About.CreditGroups, Mode=OneWay}"
                                ItemTemplate="{StaticResource AboutCreditGroupTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Legal -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:String Key=About_LegalHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind About.LegalUpdatedLabel, Mode=OneWay}"
                                FontSize="11"
                                Opacity="0.45"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{loc:String Key=About_LegalIntro}"
                                FontSize="12"
                                Opacity="0.52"
                                TextWrapping="Wrap"
                                LineHeight="18" />
                            <TextBlock
                                Text="{loc:String Key=About_OfficialPurchaseEncourage}"
                                FontSize="12"
                                Opacity="0.75"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                LineHeight="18" />
                            <Button
                                HorizontalAlignment="Left"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind About.OpenLegalFeedbackCommand}">
                                <TextBlock
                                    Text="{loc:String Key=About_LegalFeedback}"
                                    FontSize="12"
                                    Foreground="{ThemeResource ArdelAccentBrush}" />
                            </Button>
                            <ItemsControl
                                ItemsSource="{x:Bind About.LegalSections, Mode=OneWay}"
                                ItemTemplate="{StaticResource AboutLegalSectionTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Copyright Notice -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:String Key=About_CopyrightNoticeHeading}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{loc:String Key=About_CopyrightNoticeBody}"
                                FontSize="12"
                                Opacity="0.58"
                                TextWrapping="Wrap"
                                LineHeight="20"
                                IsTextSelectionEnabled="True" />
                            <Button
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                Command="{x:Bind About.OpenNoticeFileCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" Opacity="0.75" />
                                    <TextBlock Text="{loc:String Key=About_OpenNoticeFile}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="2"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
