<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ardel.Launcher.Models"
    xmlns:loc="using:Ardel.Launcher.Localization"
    NavigationCacheMode="Disabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="64,48">
        <StackPanel MaxWidth="560" Spacing="28">
            <TextBlock Text="{loc:String Key=Settings_Title}" Style="{StaticResource ArdelPageTitleStyle}" />

            <StackPanel Spacing="12">
                <TextBlock Text="{loc:String Key=Settings_Language}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="Code"
                    SelectedValue="{x:Bind ViewModel.UiLanguageCode, Mode=TwoWay}" />
                <TextBlock
                    Text="{loc:String Key=Settings_LanguageRestartHint}"
                    FontSize="12"
                    Opacity="0.6"
                    TextWrapping="Wrap" />
                <Button
                    Content="{loc:String Key=Settings_RestartNow}"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ApplyLanguageCommand}" />
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    FontSize="12"
                    Opacity="0.75"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="{loc:String Key=Settings_Java}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    PlaceholderText="{loc:String Key=Settings_JavaPlaceholder}"
                    ItemsSource="{x:Bind ViewModel.JavaInstallations, Mode=OneWay}"
                    SelectedValuePath="JavaExePath"
                    SelectedValue="{x:Bind ViewModel.JavaPath, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanEditJava, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:JavaInstallation">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ProgressRing
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Left"
                    IsActive="{x:Bind ViewModel.IsJavaBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsJavaBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{x:Bind ViewModel.JavaVersionHint, Mode=OneWay}" Opacity="0.6" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:String Key=Action_Rescan}" Command="{x:Bind ViewModel.RescanJavaCommand}" IsEnabled="{x:Bind ViewModel.CanEditJava, Mode=OneWay}" />
                    <Button Content="{loc:String Key=Action_Browse}" Command="{x:Bind ViewModel.BrowseJavaCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="{loc:String Key=Settings_MaxMemory}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" Opacity="0.75">
                        <Run Text="{x:Bind ViewModel.MaxRamMb, Mode=OneWay}" />
                        <Run Text="{loc:String Key=Settings_MemoryUnitMb}" />
                    </TextBlock>
                </Grid>
                <Slider
                    Minimum="1024"
                    Maximum="16384"
                    StepFrequency="256"
                    Value="{x:Bind ViewModel.MaxRamMb, Mode=TwoWay}" />
            </StackPanel>

            <Grid>
                <StackPanel>
                    <TextBlock Text="{loc:String Key=Settings_BmclTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock FontSize="12" Opacity="0.6" Text="{loc:String Key=Settings_BmclHint}" />
                </StackPanel>
                <ToggleSwitch
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    OffContent="{loc:String Key=Settings_Off}"
                    OnContent="{loc:String Key=Settings_On}"
                    IsOn="{x:Bind ViewModel.UseBmclApi, Mode=TwoWay}" />
            </Grid>

            <StackPanel Spacing="12">
                <TextBlock Text="{loc:String Key=Settings_GameDirectory}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           Text="{loc:String Key=Settings_GameDirectoryHint}" />
                <TextBox Text="{x:Bind ViewModel.GameDirectory, Mode=OneWay}" IsReadOnly="True" />
                <Button Content="{loc:String Key=Action_OpenMinecraftFolder}" Command="{x:Bind ViewModel.OpenGameDirectoryCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <Grid>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Opacity="0.7" VerticalAlignment="Center" />
                <Button
                    Content="{loc:String Key=Action_Save}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
