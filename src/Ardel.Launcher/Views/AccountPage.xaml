<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ardel.Launcher.ViewModels"
    xmlns:loc="using:Ardel.Launcher.Localization"
    NavigationCacheMode="Disabled">

    <Grid x:Name="RootGrid" Padding="40,28,40,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:String Key=Account_Title}" Style="{StaticResource ArdelPageTitleStyle}" Margin="0" />
                <TextBlock Text="{loc:String Key=Account_Subtitle}" Style="{StaticResource ArdelSectionCaptionStyle}" Margin="0" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Content="{loc:String Key=Account_Add}"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Center"
                MinHeight="40"
                Click="AddAccount_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                x:Name="AccountList"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="AccountList_ItemClick"
                ShowsScrollingPlaceholders="False">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="18" IsStaggeringEnabled="True" />
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountItemViewModel">
                        <Border
                            Padding="16,14"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="56" Height="56">
                                    <Border
                                        Width="56"
                                        Height="56"
                                        CornerRadius="28"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{x:Bind HasAvatarImage, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock
                                            Text="{x:Bind AvatarInitial}"
                                            FontSize="22"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <Border
                                        Width="56"
                                        Height="56"
                                        CornerRadius="12"
                                        Visibility="{x:Bind HasAvatarImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind AvatarImage, Mode=OneWay}" Stretch="Uniform" AlignmentX="Center" AlignmentY="Center" />
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Text="{x:Bind DisplayName}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Padding="8,2"
                                            CornerRadius="4"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{loc:String Key=Account_ActiveBadge}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind KindLabel}" FontSize="12" Opacity="0.7" />
                                    <TextBlock
                                        Text="{x:Bind Uuid}"
                                        FontSize="11"
                                        Opacity="0.55"
                                        FontFamily="Consolas"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind SkinLabel}"
                                        FontSize="11"
                                        Opacity="0.55"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                                    <Button
                                        ToolTipService.ToolTip="{loc:String Key=Account_Edit}"
                                        Tag="{x:Bind}"
                                        Click="EditAccount_Click"
                                        Width="40"
                                        Height="36"
                                        Padding="0">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    </Button>
                                    <Button
                                        ToolTipService.ToolTip="{loc:String Key=Account_Skin}"
                                        Tag="{x:Bind}"
                                        Click="SkinAccount_Click"
                                        Width="40"
                                        Height="36"
                                        Padding="0">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                                    </Button>
                                    <Button
                                        ToolTipService.ToolTip="{loc:String Key=Action_Delete}"
                                        Tag="{x:Bind}"
                                        Click="DeleteAccount_Click"
                                        Width="40"
                                        Height="36"
                                        Padding="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Text="{loc:String Key=Account_Empty}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.5"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <TextBlock
            Grid.Row="2"
            Margin="0,8,0,0"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            FontSize="12"
            Opacity="0.7"
            TextWrapping="Wrap" />
    </Grid>
</Page>
