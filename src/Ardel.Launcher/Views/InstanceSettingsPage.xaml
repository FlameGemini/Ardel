<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.InstanceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ardel.Launcher.Models"
    xmlns:vm="using:Ardel.Launcher.ViewModels"
    xmlns:local="using:Ardel.Launcher.Views"
    xmlns:loc="using:Ardel.Launcher.Localization"
    NavigationCacheMode="Enabled">



    <Grid Padding="24,24,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Click="BackButton_Click"
                Style="{StaticResource ArdelIconButtonStyle}"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{loc:String Key=Action_Back}">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <Border
                Grid.Column="1"
                Width="48"
                Height="48"
                CornerRadius="8"
                VerticalAlignment="Center"
                Background="{ThemeResource ArdelSoftAccentBrush}">
                <Grid>
                    <FontIcon
                        Glyph="{x:Bind ViewModel.IconGlyph, Mode=OneWay}"
                        FontSize="20"
                        Foreground="{ThemeResource ArdelAccentBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasCustomIcon, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Image
                        Source="{x:Bind ViewModel.IconImage, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind ViewModel.HasCustomIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind ViewModel.VersionIdDisplay, Mode=OneWay}"
                    FontSize="24"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{x:Bind ViewModel.InfoSummary, Mode=OneWay}"
                    FontSize="13"
                    Opacity="0.55"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button
                Grid.Column="3"
                Content="{loc:String Key=Action_Launch}"
                Style="{StaticResource AccentButtonStyle}"
                MinHeight="40"
                Padding="20,0"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.LaunchCommand}"
                IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <!-- Real columns (not overlay Padding) so content sits flush beside the rail. -->
            <Grid x:Name="SettingsChromeGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="CategoryRailHost"
                    Grid.Column="0"
                    Background="Transparent">
                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <StackPanel x:Name="CategoryNavPanel" Spacing="0">
                            <RadioButton
                                Tag="0"
                                GroupName="InstanceSettingsCategory"
                                Style="{StaticResource InstanceSettingsNavRadioStyle}"
                                IsChecked="True"
                                Checked="CategoryNav_Checked"
                                Content="{loc:String Key=InstanceSettings_NavOverview}" />
                            <RadioButton
                                Tag="1"
                                GroupName="InstanceSettingsCategory"
                                Style="{StaticResource InstanceSettingsNavRadioStyle}"
                                Checked="CategoryNav_Checked"
                                Content="{loc:String Key=InstanceSettings_NavSettings}" />
                            <RadioButton
                                Tag="2"
                                GroupName="InstanceSettingsCategory"
                                Style="{StaticResource InstanceSettingsNavRadioStyle}"
                                Checked="CategoryNav_Checked"
                                Content="{loc:String Key=InstanceSettings_NavManage}" />
                            <Border Height="1" Margin="8,8" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />
                            <RadioButton
                                Tag="3"
                                GroupName="InstanceSettingsCategory"
                                Style="{StaticResource InstanceSettingsNavRadioStyle}"
                                Checked="CategoryNav_Checked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{ThemeResource ArdelAccentBrush}" />
                                    <TextBlock Text="{loc:String Key=InstanceSettings_NavMods}" VerticalAlignment="Center" FontSize="14" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                Tag="4"
                                GroupName="InstanceSettingsCategory"
                                Style="{StaticResource InstanceSettingsNavRadioStyle}"
                                Checked="CategoryNav_Checked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource ArdelAccentBrush}" />
                                    <TextBlock Text="{loc:String Key=InstanceSettings_NavResourcepacks}" VerticalAlignment="Center" FontSize="14" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                Tag="5"
                                GroupName="InstanceSettingsCategory"
                                Style="{StaticResource InstanceSettingsNavRadioStyle}"
                                Checked="CategoryNav_Checked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE706;" FontSize="14" Foreground="{ThemeResource ArdelAccentBrush}" />
                                    <TextBlock Text="{loc:String Key=InstanceSettings_NavShaderpacks}" VerticalAlignment="Center" FontSize="14" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                Tag="6"
                                GroupName="InstanceSettingsCategory"
                                Style="{StaticResource InstanceSettingsNavRadioStyle}"
                                Checked="CategoryNav_Checked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE74C;" FontSize="14" Foreground="{ThemeResource ArdelAccentBrush}" />
                                    <TextBlock Text="{loc:String Key=InstanceSettings_NavSaves}" VerticalAlignment="Center" FontSize="14" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                Tag="7"
                                GroupName="InstanceSettingsCategory"
                                Style="{StaticResource InstanceSettingsNavRadioStyle}"
                                Checked="CategoryNav_Checked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{ThemeResource ArdelAccentBrush}" />
                                    <TextBlock Text="{loc:String Key=InstanceSettings_NavStatistics}" VerticalAlignment="Center" FontSize="14" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border
                    Grid.Column="1"
                    Width="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.55" />

                <Border
                    x:Name="ContentHost"
                    Grid.Column="2"
                    Padding="4,0,0,0"
                    Background="Transparent">
                    <Grid x:Name="SettingPanelsContainer">
                <ScrollViewer
                    x:Name="OverviewPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,8,8"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="22">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:String Key=InstanceSettings_Icon}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:String Key=InstanceSettings_IconChange}" Command="{x:Bind ViewModel.BrowseIconCommand}" />
                                <Button
                                    Content="{loc:String Key=InstanceSettings_IconClear}"
                                    Command="{x:Bind ViewModel.ClearIconCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasCustomIcon, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Text="{loc:String Key=InstanceSettings_IconPresetLib}" FontSize="12" Opacity="0.55" Margin="0,4,0,0" />
                            <GridView
                                ItemsSource="{x:Bind ViewModel.PresetGlyphs}"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="PresetIcon_ItemClick"
                                Padding="0"
                                Margin="0,4,0,0">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            Width="36"
                                            Height="36"
                                            CornerRadius="{ThemeResource ArdelBtnCornerRadius}"
                                            Background="{ThemeResource ArdelSoftAccentBrush}"
                                            Margin="2">
                                            <FontIcon
                                                Glyph="{x:Bind}"
                                                FontSize="16"
                                                Foreground="{ThemeResource ArdelAccentBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:String Key=InstanceSettings_Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Text="{x:Bind ViewModel.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="100" />
                                <Button
                                    Grid.Column="1"
                                    Content="{loc:String Key=Action_Apply}"
                                    Command="{x:Bind ViewModel.RenameCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanRename, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:String Key=InstanceSettings_Notes}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox
                                Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{loc:String Key=InstanceSettings_NotesPlaceholder}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="72" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <CheckBox
                                Content="{loc:String Key=InstanceSettings_PinQuickLaunch}"
                                IsChecked="{x:Bind ViewModel.PinToQuickLaunch, Mode=TwoWay}" />
                            <TextBlock
                                Text="{loc:String Key=InstanceSettings_PinQuickLaunchHint}"
                                FontSize="12"
                                Opacity="0.55"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Instance Details Panel -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:String Key=Catalog_DetailTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid RowSpacing="6" ColumnSpacing="16" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Type -->
                                <TextBlock Text="{loc:String Key=InstanceSettings_InfoType}" Opacity="0.55" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.KindLabelText, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold" />

                                <!-- Base version -->
                                <TextBlock Grid.Row="1" Text="{loc:String Key=InstanceSettings_InfoBase}" Opacity="0.55" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.BaseLabelText, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold" />

                                <!-- Suggested Java -->
                                <TextBlock Grid.Row="2" Text="{loc:String Key=InstanceSettings_InfoJava}" Opacity="0.55" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SuggestedJavaText, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:String Key=InstanceSettings_Folders}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{loc:String Key=InstanceSettings_IsolationHint}"
                                FontSize="12"
                                Opacity="0.55"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:String Key=InstanceSettings_OpenFolder}" Command="{x:Bind ViewModel.OpenInstanceFolderCommand}" />
                                <Button Content="{loc:String Key=InstanceSettings_CopyPath}" Command="{x:Bind ViewModel.CopyPathCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Configuration (Runtime, Window, Advanced) -->
                <ScrollViewer x:Name="JavaConfigPanel" x:Load="False" VerticalScrollBarVisibility="Auto" Padding="0,0,8,8" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="28">
                        
                        <!-- Java Configuration -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:String Key=Settings_Java}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <CheckBox
                                Content="{loc:String Key=InstanceSettings_OverrideJava}"
                                IsChecked="{x:Bind ViewModel.OverrideJava, Mode=TwoWay}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.JavaVersionHint, Mode=OneWay}"
                                FontSize="12"
                                Opacity="0.55"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.OverrideJava, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                            <StackPanel
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.OverrideJava, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="{loc:String Key=Settings_JavaPlaceholder}"
                                    ItemsSource="{x:Bind ViewModel.JavaInstallations, Mode=OneWay}"
                                    SelectedValuePath="JavaExePath"
                                    SelectedValue="{x:Bind ViewModel.JavaPath, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanEditJava, Mode=OneWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:JavaInstallation">
                                            <TextBlock Text="{x:Bind DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{x:Bind ViewModel.JavaVersionHint, Mode=OneWay}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:String Key=Action_Rescan}" Command="{x:Bind ViewModel.RescanJavaCommand}" IsEnabled="{x:Bind ViewModel.CanEditJava, Mode=OneWay}" />
                                    <Button Content="{loc:String Key=Action_Browse}" Command="{x:Bind ViewModel.BrowseJavaCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Memory Configuration -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:String Key=Settings_MaxMemory}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <RadioButton
                                Content="{loc:String Key=Memory_FollowDefault}"
                                GroupName="InstanceMemoryMode"
                                IsChecked="{x:Bind ViewModel.IsMemoryFollowDefault, Mode=TwoWay}" />
                            <TextBlock
                                Margin="28,0,0,4"
                                FontSize="12"
                                Opacity="0.55"
                                TextWrapping="Wrap"
                                Text="{x:Bind ViewModel.FollowMemoryHintText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowFollowMemoryHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                            <RadioButton
                                Content="{loc:String Key=Memory_Custom}"
                                GroupName="InstanceMemoryMode"
                                IsChecked="{x:Bind ViewModel.IsMemoryCustom, Mode=TwoWay}" />
                            <StackPanel
                                Margin="28,0,0,4"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.ShowCustomMemoryControls, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="{loc:String Key=InstanceSettings_MaxMemory}" Opacity="0.75" VerticalAlignment="Center" />
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75">
                                        <Run Text="{x:Bind ViewModel.MaxRamMb, Mode=OneWay}" />
                                        <Run Text="{loc:String Key=Settings_MemoryUnitMb}" />
                                    </TextBlock>
                                </Grid>
                                <Slider
                                    Minimum="1024"
                                    Maximum="{x:Bind ViewModel.MemorySliderMaximum, Mode=OneWay}"
                                    StepFrequency="256"
                                    Value="{x:Bind ViewModel.MaxRamMb, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <RadioButton
                                    Content="{loc:String Key=Memory_Dynamic}"
                                    GroupName="InstanceMemoryMode"
                                    VerticalAlignment="Center"
                                    IsChecked="{x:Bind ViewModel.IsMemoryDynamic, Mode=TwoWay}" />
                                <Border
                                    VerticalAlignment="Center"
                                    Padding="6,2"
                                    CornerRadius="4"
                                    Background="{ThemeResource ArdelSoftAccentBrush}">
                                    <TextBlock
                                        Text="{loc:String Key=Memory_Beta}"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource ArdelAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="28,0,0,0"
                                Text="{loc:String Key=Memory_DynamicHint}"
                                FontSize="12"
                                Opacity="0.5"
                                TextWrapping="Wrap" />

                            <!-- Memory map: soft track + accent game band + legend -->
                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                <Grid>
                                    <TextBlock
                                        Text="{loc:String Key=InstanceSettings_MemoryMap}"
                                        FontSize="12"
                                        Opacity="0.55" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Opacity="0.45">
                                        <Run Text="{x:Bind ViewModel.MemoryTotalText, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{loc:String Key=InstanceSettings_MemoryTotal}" />
                                    </TextBlock>
                                </Grid>

                                <Grid Height="8">
                                    <Border
                                        CornerRadius="4"
                                        Background="{ThemeResource ArdelSoftAccentBrush}"
                                        Opacity="0.55" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind ViewModel.MemoryUsedColumn, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind ViewModel.MemoryGameColumn, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind ViewModel.MemoryEmptyColumn, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            CornerRadius="4,0,0,4"
                                            Background="{ThemeResource ArdelMuteBrush}"
                                            Opacity="0.55" />
                                        <Border
                                            Grid.Column="1"
                                            Background="{ThemeResource ArdelAccentBrush}" />
                                    </Grid>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border
                                                Width="8"
                                                Height="8"
                                                CornerRadius="2"
                                                Background="{ThemeResource ArdelMuteBrush}"
                                                Opacity="0.7"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{loc:String Key=InstanceSettings_MemoryUsed}"
                                                FontSize="11"
                                                Opacity="0.55"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{x:Bind ViewModel.MemoryUsedText, Mode=OneWay}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Margin="16,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border
                                                Width="8"
                                                Height="8"
                                                CornerRadius="2"
                                                Background="{ThemeResource ArdelAccentBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{loc:String Key=InstanceSettings_MemoryGame}"
                                                FontSize="11"
                                                Opacity="0.55"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{x:Bind ViewModel.MemoryGameText, Mode=OneWay}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource ArdelAccentBrush}"
                                            Margin="16,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border
                                                Width="8"
                                                Height="8"
                                                CornerRadius="2"
                                                BorderThickness="1.5"
                                                BorderBrush="{ThemeResource ArdelMuteBrush}"
                                                Opacity="0.45"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{loc:String Key=InstanceSettings_MemoryFree}"
                                                FontSize="11"
                                                Opacity="0.55"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{x:Bind ViewModel.MemoryFreeText, Mode=OneWay}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Opacity="0.75"
                                            Margin="16,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Window Configurations -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:String Key=InstanceSettings_Window}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBox
                                Header="{loc:String Key=InstanceSettings_GameWindowTitle}"
                                PlaceholderText="{loc:String Key=InstanceSettings_GameWindowTitlePlaceholder}"
                                Text="{x:Bind ViewModel.WindowTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Text="{loc:String Key=InstanceSettings_GameWindowTitleHint}"
                                FontSize="12"
                                Opacity="0.5"
                                TextWrapping="Wrap" />
                            <ComboBox
                                Header="{loc:String Key=InstanceSettings_ResolutionPreset}"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.ResolutionPresets}"
                                DisplayMemberPath="Label"
                                SelectedItem="{x:Bind ViewModel.SelectedResolutionPreset, Mode=TwoWay}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="{loc:String Key=InstanceSettings_Width}"
                                    PlaceholderText="{loc:String Key=InstanceSettings_ResolutionDefault}"
                                    Text="{x:Bind ViewModel.ScreenWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Grid.Column="1"
                                    Header="{loc:String Key=InstanceSettings_Height}"
                                    PlaceholderText="{loc:String Key=InstanceSettings_ResolutionDefault}"
                                    Text="{x:Bind ViewModel.ScreenHeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <ToggleSwitch
                                Header="{loc:String Key=InstanceSettings_FullScreen}"
                                OffContent="{loc:String Key=Settings_Off}"
                                OnContent="{loc:String Key=Settings_On}"
                                IsOn="{x:Bind ViewModel.FullScreen, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Server Configuration -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:String Key=InstanceSettings_Server}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{loc:String Key=InstanceSettings_ServerHint}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="{loc:String Key=InstanceSettings_ServerIp}"
                                    PlaceholderText="{loc:String Key=InstanceSettings_ServerIpPlaceholder}"
                                    Text="{x:Bind ViewModel.ServerIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Grid.Column="1"
                                    Header="{loc:String Key=InstanceSettings_ServerPort}"
                                    PlaceholderText="25565"
                                    Text="{x:Bind ViewModel.ServerPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>

                        <!-- Advanced Configurations Expander -->
                        <Expander Header="{loc:String Key=InstanceSettings_NavAdvanced}" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="16" Padding="16">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:String Key=InstanceSettings_JvmArgs}" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{loc:String Key=InstanceSettings_JvmPresetTitle}" Padding="8,4" FontSize="12">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="{loc:String Key=InstanceSettings_JvmPresetG1Gc}" Command="{x:Bind ViewModel.ImportJvmPresetCommand}" CommandParameter="g1gc" />
                                                    <MenuFlyoutItem Text="{loc:String Key=InstanceSettings_JvmPresetShenandoah}" Command="{x:Bind ViewModel.ImportJvmPresetCommand}" CommandParameter="shenandoah" />
                                                    <MenuFlyoutItem Text="{loc:String Key=InstanceSettings_JvmPresetZgc}" Command="{x:Bind ViewModel.ImportJvmPresetCommand}" CommandParameter="zgc" />
                                                    <MenuFlyoutItem Text="{loc:String Key=InstanceSettings_JvmPresetGenZgc}" Command="{x:Bind ViewModel.ImportJvmPresetCommand}" CommandParameter="genzgc" />
                                                    <MenuFlyoutItem Text="{loc:String Key=InstanceSettings_JvmPresetGraalVm}" Command="{x:Bind ViewModel.ImportJvmPresetCommand}" CommandParameter="graalvm" />
                                                    <MenuFlyoutItem Text="{loc:String Key=InstanceSettings_JvmPresetLowLatency}" Command="{x:Bind ViewModel.ImportJvmPresetCommand}" CommandParameter="lowlatency" />
                                                    <MenuFlyoutItem Text="{loc:String Key=InstanceSettings_JvmPresetLowMemory}" Command="{x:Bind ViewModel.ImportJvmPresetCommand}" CommandParameter="lowpc" />
                                                    <MenuFlyoutItem Text="{loc:String Key=InstanceSettings_JvmPresetAikar}" Command="{x:Bind ViewModel.ImportJvmPresetCommand}" CommandParameter="aikar" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="{loc:String Key=InstanceSettings_JvmPresetClean}" Command="{x:Bind ViewModel.ImportJvmPresetCommand}" CommandParameter="clean" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <TextBox
                                        Text="{x:Bind ViewModel.ExtraJvmArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{loc:String Key=InstanceSettings_JvmArgsPlaceholder}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="80" />
                                </StackPanel>
                                <TextBox
                                    Header="{loc:String Key=InstanceSettings_GameArgs}"
                                    Text="{x:Bind ViewModel.ExtraGameArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:String Key=InstanceSettings_GameArgsPlaceholder}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="80" />
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- Manage -->
                <ScrollViewer x:Name="ManagePanel" x:Load="False" VerticalScrollBarVisibility="Auto" Padding="0,0,8,8" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="24">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:String Key=InstanceSettings_DuplicateTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{loc:String Key=InstanceSettings_DuplicateHint}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                            <Button
                                Content="{loc:String Key=InstanceSettings_Duplicate}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.DuplicateCommand}"
                                IsEnabled="{x:Bind ViewModel.CanDuplicate, Mode=OneWay}" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />

                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:String Key=InstanceSettings_ExportTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{loc:String Key=InstanceSettings_ExportHint}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                            <Button
                                Content="{loc:String Key=InstanceSettings_Export}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.ExportCommand}" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />

                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:String Key=InstanceSettings_ResetTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{loc:String Key=InstanceSettings_ResetHint}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                            <Button
                                Content="{loc:String Key=InstanceSettings_Reset}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.ResetSettingsCommand}" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />

                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:String Key=Instances_DeleteTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{loc:String Key=InstanceSettings_DeleteHint}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                            <Button
                                Content="{loc:String Key=Instances_DeleteTitle}"
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Command="{x:Bind ViewModel.DeleteCommand}"
                                IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Mods (Index 3): pinned toolbar; ListView owns item scroll. -->
                <Grid
                    x:Name="ModsPanel"
                    x:Load="False"
                    AllowDrop="True"
                    DragOver="ModsContainer_DragOver"
                    Drop="ModsContainer_Drop"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,8,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <TextBlock Text="{loc:String Key=InstanceSettings_NavMods}" Style="{StaticResource TitleTextBlockStyle}" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <RadioButton Content="{loc:String Key=InstanceSettings_ModFilterAll}" GroupName="ModFilter" Tag="0" Click="ModFilterRadio_Click" IsChecked="{x:Bind ViewModel.ModFilterIndex, Mode=OneWay, Converter={StaticResource EqualValueToBool}, ConverterParameter=0}" Style="{StaticResource ToggleButtonRadioButtonStyle}" />
                                    <RadioButton Content="{loc:String Key=InstanceSettings_ModFilterEnabled}" GroupName="ModFilter" Tag="1" Click="ModFilterRadio_Click" IsChecked="{x:Bind ViewModel.ModFilterIndex, Mode=OneWay, Converter={StaticResource EqualValueToBool}, ConverterParameter=1}" Style="{StaticResource ToggleButtonRadioButtonStyle}" />
                                    <RadioButton Content="{loc:String Key=InstanceSettings_ModFilterDisabled}" GroupName="ModFilter" Tag="2" Click="ModFilterRadio_Click" IsChecked="{x:Bind ViewModel.ModFilterIndex, Mode=OneWay, Converter={StaticResource EqualValueToBool}, ConverterParameter=2}" Style="{StaticResource ToggleButtonRadioButtonStyle}" />
                                    <RadioButton Content="{x:Bind ViewModel.UpdatableFilterLabel, Mode=OneWay}" GroupName="ModFilter" Tag="3" Click="ModFilterRadio_Click" IsChecked="{x:Bind ViewModel.ModFilterIndex, Mode=OneWay, Converter={StaticResource EqualValueToBool}, ConverterParameter=3}" Style="{StaticResource ToggleButtonRadioButtonStyle}" Visibility="{x:Bind ViewModel.HasUpdatableMods, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button
                                    Command="{x:Bind ViewModel.SearchModsForInstanceCommand}"
                                    ToolTipService.ToolTip="{loc:String Key=Nav_Download}"
                                    Width="36" Height="32" Padding="0" MinWidth="0">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                </Button>
                                <Button
                                    Command="{x:Bind ViewModel.RefreshResourceListsCommand}"
                                    ToolTipService.ToolTip="{loc:String Key=Action_Refresh}"
                                    Width="36" Height="32" Padding="0" MinWidth="0">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                                <Button
                                    Command="{x:Bind ViewModel.OpenFolderCommand}"
                                    CommandParameter="mods"
                                    ToolTipService.ToolTip="{loc:String Key=Action_OpenFolder}"
                                    Width="36" Height="32" Padding="0" MinWidth="0">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                </Button>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowModSelectionActions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedModsCountText, Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.7" />
                                    <Button
                                        Command="{x:Bind ViewModel.EnableSelectedModsCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanEnableSelectedMods, Mode=OneWay}"
                                        ToolTipService.ToolTip="{loc:String Key=InstanceSettings_ToggleEnable}"
                                        Width="36" Height="32" Padding="0">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                    </Button>
                                    <Button
                                        Command="{x:Bind ViewModel.DisableSelectedModsCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanDisableSelectedMods, Mode=OneWay}"
                                        ToolTipService.ToolTip="{loc:String Key=InstanceSettings_ToggleDisable}"
                                        Width="36" Height="32" Padding="0">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                    <Button
                                        Command="{x:Bind ViewModel.DeleteSelectedModsCommand}"
                                        ToolTipService.ToolTip="{loc:String Key=InstanceSettings_DeleteItem}"
                                        Width="36" Height="32" Padding="0"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                    <Button
                                        Command="{x:Bind ViewModel.ClearSelectedModsCommand}"
                                        ToolTipService.ToolTip="{loc:String Key=Action_ClearSelection}"
                                        Width="36" Height="32" Padding="0">
                                        <FontIcon Glyph="&#xE8E6;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ModUpdateStatusText, Mode=OneWay}"
                            FontSize="12"
                            Opacity="0.6"
                            Visibility="{x:Bind ViewModel.HasModUpdateStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{x:Bind ViewModel.ShowRegularModsList, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel
                                Spacing="6"
                                Padding="8,12"
                                Visibility="{x:Bind ViewModel.IsModsListEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.EmptyModsMessage, Mode=OneWay}"
                                    FontSize="13"
                                    Opacity="0.7"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{loc:String Key=InstanceSettings_EmptyDropHint}"
                                    FontSize="12"
                                    Opacity="0.5"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <ListView
                        x:Name="ModsListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.ModsList, Mode=OneWay}"
                        SelectionMode="None"
                        Padding="0,0,8,8"
                        Visibility="{x:Bind ViewModel.ShowRegularModsList, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="ManipulationMode" Value="None" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResourceItem">
                                <Grid Padding="12,8" ColumnSpacing="12" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.ColumnSpan="3"
                                        CornerRadius="8"
                                        Background="{ThemeResource ArdelSoftAccentBrush}"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        IsHitTestVisible="False" />
                                    <Border
                                        Width="3"
                                        Margin="0,4"
                                        HorizontalAlignment="Left"
                                        CornerRadius="2"
                                        Background="{ThemeResource ArdelAccentBrush}"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        IsHitTestVisible="False" />
                                    <Grid Grid.Column="0" Width="36" Height="36" IsHitTestVisible="False">
                                        <Border Width="36" Height="36" CornerRadius="6" Background="Transparent">
                                            <Image Source="{x:Bind IconImage, Mode=OneWay}" Width="36" Height="36" Stretch="UniformToFill" />
                                        </Border>
                                        <Border
                                            Width="36"
                                            Height="36"
                                            CornerRadius="6"
                                            Background="#99000000"
                                            Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FileName}" FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Command="{x:Bind ToggleEnableCommand, Mode=OneWay}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ToggleToolTip, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind ToggleGlyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind ToggleForeground, Mode=OneWay}" />
                                        </Button>
                                        <Button Command="{x:Bind OpenPageCommand}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="{loc:String Key=InstanceSettings_OpenWeb}">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                        </Button>
                                        <Button Command="{x:Bind OpenItemFolderCommand}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="{loc:String Key=InstanceSettings_OpenItemFolder}">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                        </Button>
                                        <Button Command="{x:Bind DeleteItemCommand}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ToolTipService.ToolTip="{loc:String Key=InstanceSettings_DeleteItem}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid
                        Grid.Row="1"
                        Padding="0,0,8,8"
                        Visibility="{x:Bind ViewModel.ShowUpdatableModsList, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView
                            Grid.Row="0"
                            ItemsSource="{x:Bind ViewModel.UpdatableMods, Mode=OneWay}"
                            SelectionMode="None"
                            Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModUpdateCandidate">
                                    <Border
                                        Padding="14,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource ArdelCardCornerRadius}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="Transparent">
                                                <Image Source="{x:Bind IconImage}" Width="40" Height="40" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind VersionChangeLabel}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="{loc:String Key=InstanceSettings_ModUpdateSelectAll}" Command="{x:Bind ViewModel.SelectAllUpdatableModsCommand}" />
                            <Button Grid.Column="1" Content="{loc:String Key=InstanceSettings_ModUpdateSelectNone}" Command="{x:Bind ViewModel.ClearUpdatableModsSelectionCommand}" />
                            <Button
                                Grid.Column="3"
                                Content="{loc:String Key=InstanceSettings_ModUpdateAction}"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="120"
                                Command="{x:Bind ViewModel.UpdateSelectedModsCommand}"
                                IsEnabled="{x:Bind ViewModel.CanUpdateSelectedMods, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Resourcepacks (Index 4) -->
                <local:InstancePackManagerPanel
                    x:Name="ResourcePacksPanel"
                    x:Load="False"
                    Manager="{x:Bind ViewModel.ResourcePacks, Mode=OneWay}"
                    Title="{loc:String Key=InstanceSettings_NavResourcepacks}"
                     Visibility="Collapsed"/>

                <!-- Shaderpacks (Index 5) -->
                <local:InstancePackManagerPanel
                    x:Name="ShaderPacksPanel"
                    x:Load="False"
                    Manager="{x:Bind ViewModel.ShaderPacks, Mode=OneWay}"
                    Title="{loc:String Key=InstanceSettings_NavShaderpacks}"
                     Visibility="Collapsed"/>

                <!-- Saves (Index 6): pinned toolbar; ListView owns item scroll. -->
                <Grid
                    x:Name="SavesPanel"
                    x:Load="False"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,8,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:String Key=InstanceSettings_NavSaves}" Style="{StaticResource TitleTextBlockStyle}" FontSize="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button
                                    Command="{x:Bind ViewModel.RefreshResourceListsCommand}"
                                    ToolTipService.ToolTip="{loc:String Key=Action_Refresh}"
                                    Width="36" Height="32" Padding="0" MinWidth="0">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                                <Button
                                    Command="{x:Bind ViewModel.OpenFolderCommand}"
                                    CommandParameter="saves"
                                    ToolTipService.ToolTip="{loc:String Key=Action_OpenFolder}"
                                    Width="36" Height="32" Padding="0" MinWidth="0">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />
                        <StackPanel
                            Spacing="6"
                            Padding="8,12"
                            Visibility="{x:Bind ViewModel.IsSavesEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                Text="{loc:String Key=InstanceSettings_EmptySaves}"
                                FontSize="13"
                                Opacity="0.7"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.SavesList, Mode=OneWay}"
                        SelectionMode="None"
                        Padding="0,0,8,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResourceItem">
                                <Border
                                    Padding="12,10"
                                    Margin="0,0,0,6"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind FileName}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind DateText}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                            <Button Command="{x:Bind OpenSavePropertiesCommand}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="{loc:String Key=InstanceSettings_SaveAdvancedButton}">
                                                <FontIcon Glyph="&#xE946;" FontSize="14" />
                                            </Button>
                                            <Button Command="{x:Bind OpenItemFolderCommand}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="{loc:String Key=InstanceSettings_OpenItemFolder}">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            </Button>
                                            <Button Command="{x:Bind DeleteItemCommand}" Width="32" Height="32" Padding="0" MinWidth="0" MinHeight="0" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ToolTipService.ToolTip="{loc:String Key=InstanceSettings_DeleteItem}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Statistics (Index 7) -->
                <ScrollViewer
                    x:Name="StatisticsPanel"
                    x:Load="False"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,8,8">
                    <StackPanel Spacing="20">
                        <TextBlock Text="{loc:String Key=InstanceSettings_NavStatistics}" Style="{StaticResource TitleTextBlockStyle}" FontSize="20" />
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />

                        <TextBlock
                            Text="{loc:String Key=InstanceSettings_StatsNoData}"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsStatisticsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel
                            Spacing="20"
                            Visibility="{x:Bind ViewModel.StatisticsContentVisibility, Mode=OneWay}">
                            <Grid
                                x:Name="StatsMetricsRoot"
                                ColumnSpacing="12"
                                RowSpacing="12">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="StatsMetricsWidthStates">
                                        <VisualState x:Name="StatsMetricsNarrow" />
                                        <VisualState x:Name="StatsMetricsWide">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="1100" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="StatsMetricsCol2.Width" Value="*" />
                                                <Setter Target="StatsMetricsCol3.Width" Value="*" />
                                                <Setter Target="StatsCardLastPlayed.(Grid.Row)" Value="0" />
                                                <Setter Target="StatsCardLastPlayed.(Grid.Column)" Value="2" />
                                                <Setter Target="StatsCardAvg.(Grid.Row)" Value="0" />
                                                <Setter Target="StatsCardAvg.(Grid.Column)" Value="3" />
                                                <Setter Target="StatsMetricsRow1.Height" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="StatsMetricsCol2" Width="0" />
                                    <ColumnDefinition x:Name="StatsMetricsCol3" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="StatsMetricsRow1" Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Padding="16,14"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MinHeight="76">
                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:String Key=InstanceSettings_StatsTotalPlayTime}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind ViewModel.StatsTotalPlayTimeText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="16,14"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MinHeight="76">
                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:String Key=InstanceSettings_StatsLaunchCount}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind ViewModel.StatsLaunchCountText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="StatsCardLastPlayed"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Padding="16,14"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MinHeight="76">
                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:String Key=InstanceSettings_StatsLastPlayed}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind ViewModel.StatsLastPlayedText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="StatsCardAvg"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Padding="16,14"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MinHeight="76">
                                    <StackPanel Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:String Key=InstanceSettings_StatsAvgSession}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="{x:Bind ViewModel.StatsAvgSessionText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:String Key=InstanceSettings_StatsPlayTrend}" FontWeight="SemiBold" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.PlayDayBars, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinColumnSpacing="6" MinRowSpacing="0" MaximumRowsOrColumns="14" Orientation="Horizontal" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:PlayDayBarItem">
                                            <StackPanel
                                                Spacing="4"
                                                HorizontalAlignment="Center"
                                                Width="36"
                                                ToolTipService.ToolTip="{x:Bind ToolTip}">
                                                <Grid Height="80" VerticalAlignment="Bottom">
                                                    <Border
                                                        Height="{x:Bind BarHeight}"
                                                        Width="20"
                                                        VerticalAlignment="Bottom"
                                                        CornerRadius="4"
                                                        Background="{ThemeResource ArdelAccentBrush}"
                                                        Opacity="{x:Bind BarOpacity}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Label}" FontSize="10" Opacity="0.55" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <StackPanel
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.HasScreenshotGallery, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{loc:String Key=InstanceSettings_StatsScreenshots}"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource ArdelTextNavButtonStyle}"
                                        Command="{x:Bind ViewModel.OpenScreenshotsFolderCommand}"
                                        Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                            <TextBlock Text="{loc:String Key=InstanceSettings_StatsOpenScreenshots}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollMode="Disabled">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ScreenshotThumbs, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:ScreenshotThumbItem">
                                                <Border
                                                    Width="96"
                                                    Height="64"
                                                    CornerRadius="8"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    ToolTipService.ToolTip="{x:Bind FileName}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{x:Bind Image}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SavePropertiesPanel" x:Load="False" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    Style="{StaticResource ArdelTextNavButtonStyle}"
                    Command="{x:Bind ViewModel.CloseSavePropertiesCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="10" />
                        <TextBlock Text="{loc:String Key=InstanceSettings_NavSaves}" FontSize="13" />
                    </StackPanel>
                </Button>

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,8,8">
                    <StackPanel Spacing="22" MaxWidth="560" HorizontalAlignment="Stretch">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.IsSavePropertiesLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ProgressRing Width="18" Height="18" IsActive="True" />
                            <TextBlock
                                Text="{loc:String Key=InstanceSettings_SaveLoading}"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock
                            Text="{x:Bind ViewModel.SavePropertiesError, Mode=OneWay}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSavePropertiesError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <Button
                            Style="{StaticResource ArdelTextNavButtonStyle}"
                            Command="{x:Bind ViewModel.RestoreSaveBackupCommand}"
                            Visibility="{x:Bind ViewModel.CanRestoreSaveBackup, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:String Key=InstanceSettings_SaveRestoreBackup}" FontSize="13" />
                        </Button>

                        <StackPanel
                            Spacing="22"
                            Visibility="{x:Bind ViewModel.CanEditSaveProperties, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                            <!-- World -->
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="{loc:String Key=InstanceSettings_SaveSectionWorld}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="88" Height="88">
                                        <Border
                                            CornerRadius="10"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid>
                                                <Image
                                                    Source="{x:Bind ViewModel.SaveCoverImage, Mode=OneWay}"
                                                    Stretch="UniformToFill"
                                                    Visibility="{x:Bind ViewModel.HasSaveCover, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                <FontIcon
                                                    Glyph="&#xE7B7;"
                                                    FontSize="26"
                                                    Opacity="0.35"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind ViewModel.HasSaveCover, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,4,4"
                                            Visibility="{x:Bind ViewModel.CanManageSaveCover, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <Button
                                                Style="{StaticResource ArdelIconButtonStyle}"
                                                Command="{x:Bind ViewModel.BrowseSaveCoverCommand}"
                                                ToolTipService.ToolTip="{loc:String Key=InstanceSettings_IconChange}"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                            </Button>
                                            <Button
                                                Style="{StaticResource ArdelIconButtonStyle}"
                                                Command="{x:Bind ViewModel.ClearSaveCoverCommand}"
                                                ToolTipService.ToolTip="{loc:String Key=InstanceSettings_IconClear}"
                                                IsEnabled="{x:Bind ViewModel.HasSaveCover, Mode=OneWay}"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                        <TextBox
                                            Header="{loc:String Key=InstanceSettings_SaveWorldName}"
                                            Text="{x:Bind ViewModel.SaveWorldName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            MaxLength="128" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.SavePropertiesFolderName, Mode=OneWay}"
                                            FontSize="12"
                                            Opacity="0.5"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.SavePropertiesFolderName, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Gameplay -->
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        Header="{loc:String Key=InstanceSettings_SaveGameMode}"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.SaveGameModeOptions, Mode=OneWay}"
                                        SelectedIndex="{x:Bind ViewModel.SaveGameModeIndex, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Header="{loc:String Key=InstanceSettings_SaveDifficulty}"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.SaveDifficultyOptions, Mode=OneWay}"
                                        SelectedIndex="{x:Bind ViewModel.SaveDifficultyIndex, Mode=TwoWay}" />
                                </Grid>
                                <CheckBox
                                    Content="{loc:String Key=InstanceSettings_SaveAllowCommands}"
                                    IsChecked="{x:Bind ViewModel.SaveAllowCommands, Mode=TwoWay}"
                                    Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Info -->
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="{loc:String Key=InstanceSettings_SaveSectionInfo}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ArdelCardCornerRadius}"
                                    Padding="16,12">
                                    <Grid RowSpacing="10" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Text="{loc:String Key=InstanceSettings_SaveLastPlayed}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind ViewModel.SaveLastPlayedText, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{loc:String Key=InstanceSettings_SaveVersion}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind ViewModel.SaveGameVersion, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{loc:String Key=InstanceSettings_SaveSeed}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.HasSaveSeed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="3"
                                            Text="{x:Bind ViewModel.SaveSeedText, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind ViewModel.HasSaveSeed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{loc:String Key=InstanceSettings_SaveDay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Text="{x:Bind ViewModel.SaveDayText, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"
                                            FontSize="13"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Text="{loc:String Key=InstanceSettings_SaveHardcore}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="3"
                                            Text="{x:Bind ViewModel.SaveHardcoreText, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"
                                            FontSize="13"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Grid.Row="3"
                                            Text="{loc:String Key=InstanceSettings_SaveSpawn}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Text="{x:Bind ViewModel.SaveSpawnText, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Text="{loc:String Key=InstanceSettings_SaveDataVersion}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="3"
                                            Text="{x:Bind ViewModel.SaveDataVersionText, Mode=OneWay}"
                                            IsTextSelectionEnabled="True"
                                            FontSize="13"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="0,12,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Opacity="0.7"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
