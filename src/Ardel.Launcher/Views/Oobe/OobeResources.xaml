<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="OobeStepTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="40" />
    </Style>

    <Style x:Key="OobeStepSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="OobeTutorialStepTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="OobeTutorialStepDetailStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="OobeTutorialTimelineIconStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource ArdelSoftAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArdelAccentBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OobeTutorialTimelineConnectorStyle" TargetType="Border">
        <Setter Property="Width" Value="2" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{ThemeResource ArdelAccentBrush}" />
        <Setter Property="Opacity" Value="0.35" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="OobeTutorialStepStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="OobeTutorialStepCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="OobeTutorialStepBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{ThemeResource ArdelAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="OobeTutorialStepBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OobeFooterButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="OobePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OobeFooterButtonStyle}">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Background" Value="{ThemeResource ArdelAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="OobeThemeHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style x:Key="OobeProgressSegmentStyle" TargetType="Border">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style x:Key="OobeProgressSegmentActiveStyle" TargetType="Border" BasedOn="{StaticResource OobeProgressSegmentStyle}">
        <Setter Property="Background" Value="{ThemeResource ArdelAccentBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
</ResourceDictionary>
