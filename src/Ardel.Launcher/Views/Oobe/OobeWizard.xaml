<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ardel.Launcher.Views.Oobe.OobeWizard"
    x:Name="OobeRoot"
    x:DataType="viewmodels:OobeViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:Ardel.Launcher.ViewModels"
    xmlns:converters="using:Ardel.Launcher.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Oobe/OobeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:EqualValueToVisibilityConverter x:Key="EqualValueToVisibility" />
            <converters:BoolToThemeBrushConverter
                x:Key="LanguageCardBackgroundConverter"
                FalseResourceKey="CardBackgroundFillColorDefaultBrush"
                TrueResourceKey="ArdelSelectedBrush" />
            <converters:BoolToThemeBrushConverter
                x:Key="LanguageCardBorderConverter"
                FalseResourceKey="CardStrokeColorDefaultBrush"
                TrueResourceKey="ArdelAccentBrush" />
            <converters:BoolToThemeBrushConverter
                x:Key="LanguageLabelForegroundConverter"
                FalseResourceKey="ArdelInkBrush"
                TrueResourceKey="ArdelAccentBrush" />

            <Style x:Key="LanguageRowIconSlotStyle" TargetType="Border">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Background" Value="{ThemeResource ArdelSoftAccentBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <DataTemplate x:Key="LanguageOptionItemTemplate" x:DataType="viewmodels:LanguageOption">
                <Border
                    HorizontalAlignment="Stretch"
                    Padding="16,14"
                    CornerRadius="10"
                    Background="{x:Bind IsSelected, Mode=OneTime, Converter={StaticResource LanguageCardBackgroundConverter}}"
                    BorderBrush="{x:Bind IsSelected, Mode=OneTime, Converter={StaticResource LanguageCardBorderConverter}}"
                    BorderThickness="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="56" Height="28" VerticalAlignment="Center">
                            <Border
                                Style="{StaticResource LanguageRowIconSlotStyle}"
                                Visibility="{x:Bind IsSystemLanguage, Mode=OneTime, Converter={StaticResource BoolToVisibility}}">
                                <FontIcon
                                    Glyph="&#xE772;"
                                    FontSize="14"
                                    Foreground="{ThemeResource ArdelAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border
                                Style="{StaticResource LanguageRowIconSlotStyle}"
                                Visibility="{x:Bind CodeBadgeVisibility, Mode=OneTime}">
                                <TextBlock
                                    Text="{x:Bind CodeBadgeText}"
                                    FontFamily="Consolas"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource ArdelAccentBrush}"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Label}"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind IsSelected, Mode=OneTime, Converter={StaticResource LanguageLabelForegroundConverter}}"
                            VerticalAlignment="Center" />
                        <FontIcon
                            Grid.Column="2"
                            Glyph="&#xE73E;"
                            FontSize="14"
                            Foreground="{ThemeResource ArdelAccentBrush}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind SelectedBadgeVisibility, Mode=OneTime}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="OobeThemeCardTemplate" x:DataType="viewmodels:ThemeOption">
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Padding="0"
                    MinHeight="128"
                    CornerRadius="10"
                    Background="{x:Bind ThemeChipBackground, Mode=OneTime}"
                    BorderBrush="{x:Bind ThemeChipBorderBrush, Mode=OneTime}"
                    BorderThickness="{x:Bind ThemeChipBorderThickness, Mode=OneTime}"
                    Tag="{x:Bind Code}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Margin="8,8,8,0"
                            Height="78"
                            CornerRadius="8"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{x:Bind PreviewChromeBrush, Mode=OneTime}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{x:Bind PreviewRailBrush, Mode=OneTime}" />
                                    <Border Grid.Column="1" Background="{x:Bind PreviewCanvasBrush, Mode=OneTime}">
                                        <Border
                                            Width="40"
                                            Height="9"
                                            Margin="10,12,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            CornerRadius="4"
                                            Background="{x:Bind PreviewBrush, Mode=OneTime}"
                                            Visibility="{x:Bind ColorCircleVisibility, Mode=OneTime}" />
                                    </Border>
                                </Grid>
                                <FontIcon
                                    Grid.RowSpan="2"
                                    Glyph="&#xE770;"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind DefaultIconVisibility, Mode=OneTime}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="12,10,12,12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Label}"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Foreground="{x:Bind ThemeLabelBrush, Mode=OneTime}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                Grid.Column="1"
                                Glyph="&#xE73E;"
                                FontSize="14"
                                Foreground="{ThemeResource ArdelAccentBrush}"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind SelectedBadgeVisibility, Mode=OneTime}" />
                        </Grid>
                    </Grid>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="OobeTutorialStepTemplate" x:DataType="viewmodels:OobeTutorialStepItem">
                <Grid ColumnSpacing="20" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center" Spacing="0">
                        <Border Style="{StaticResource OobeTutorialTimelineIconStyle}">
                            <FontIcon
                                Glyph="{x:Bind IconGlyph}"
                                FontSize="18"
                                Foreground="{ThemeResource ArdelAccentBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border
                            Style="{StaticResource OobeTutorialTimelineConnectorStyle}"
                            Visibility="{x:Bind ShowConnector, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,6,0,20">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource OobeTutorialStepBadgeStyle}" Width="22" Height="22" CornerRadius="11" Margin="0">
                                <TextBlock Text="{x:Bind Index}" Style="{StaticResource OobeTutorialStepBadgeTextStyle}" FontSize="11" />
                            </Border>
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource OobeTutorialStepTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource OobeTutorialStepDetailStyle}" Margin="30,4,0,0" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Padding="56,24,56,36" RowSpacing="28" MaxWidth="1080" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="ProgressHost"
            Grid.Row="0"
            ColumnSpacing="6"
            Margin="0,4,0,8"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ProgressSeg0" Grid.Column="0" Style="{StaticResource OobeProgressSegmentActiveStyle}" />
            <Border x:Name="ProgressSeg1" Grid.Column="1" Style="{StaticResource OobeProgressSegmentStyle}" />
            <Border x:Name="ProgressSeg2" Grid.Column="2" Style="{StaticResource OobeProgressSegmentStyle}" />
            <Border x:Name="ProgressSeg3" Grid.Column="3" Style="{StaticResource OobeProgressSegmentStyle}" />
            <Border x:Name="ProgressSeg4" Grid.Column="4" Style="{StaticResource OobeProgressSegmentStyle}" />
            <Border x:Name="ProgressSeg5" Grid.Column="5" Style="{StaticResource OobeProgressSegmentStyle}" />
        </Grid>

        <Grid x:Name="BodyHost" Grid.Row="1">
            <Grid
                x:Name="SplitPanel"
                Visibility="{x:Bind ViewModel.IsSplitLayout, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="AnimStage"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinHeight="280"
                    Visibility="{x:Bind ViewModel.ShowSideArt, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon
                        x:Name="AnimGlobe"
                        Glyph="&#xE774;"
                        FontSize="72"
                        Foreground="{ThemeResource ArdelAccentBrush}"
                        Opacity="0.92"
                        Visibility="{x:Bind ViewModel.CurrentStep, Mode=OneWay, Converter={StaticResource EqualValueToVisibility}, ConverterParameter=0}" />
                    <Image
                        x:Name="AnimLangLogo"
                        Width="88"
                        Height="88"
                        Source="ms-appx:///Assets/ardel-logo.png"
                        Opacity="0"
                        Visibility="{x:Bind ViewModel.ShowLanguageLogoArt, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <FontIcon
                        x:Name="AnimPen"
                        Glyph="&#xE70F;"
                        FontSize="56"
                        Foreground="{ThemeResource ArdelAccentBrush}"
                        Visibility="{x:Bind ViewModel.CurrentStep, Mode=OneWay, Converter={StaticResource EqualValueToVisibility}, ConverterParameter=2}" />

                    <FontIcon
                        x:Name="AnimPalette"
                        Glyph="&#xE790;"
                        FontSize="72"
                        Foreground="{ThemeResource ArdelAccentBrush}"
                        Visibility="{x:Bind ViewModel.CurrentStep, Mode=OneWay, Converter={StaticResource EqualValueToVisibility}, ConverterParameter=3}" />
                </Grid>

                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    Margin="24,12"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Opacity="0.55"
                    Visibility="{x:Bind ViewModel.ShowSideArt, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer
                    x:Name="ContentScroller"
                    Grid.Column="{x:Bind ViewModel.ContentColumn, Mode=OneWay}"
                    Grid.ColumnSpan="{x:Bind ViewModel.ContentColumnSpan, Mode=OneWay}"
                    VerticalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled">
                    <Grid x:Name="ContentHost" MinHeight="280" VerticalAlignment="Center">
                        <StackPanel
                            x:Name="LanguageStepPanel"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.CurrentStep, Mode=OneWay, Converter={StaticResource EqualValueToVisibility}, ConverterParameter=0}">
                            <TextBlock Text="{x:Bind ViewModel.StepLanguageTitle, Mode=OneWay}" Style="{StaticResource OobeStepTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.StepLanguageSubtitle, Mode=OneWay}" Style="{StaticResource OobeStepSubtitleStyle}" />
                            <ScrollViewer
                                MaxHeight="400"
                                VerticalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Enabled"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled">
                                <ListView
                                    x:Name="LanguageOptionsList"
                                    ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                                    ItemTemplate="{StaticResource LanguageOptionItemTemplate}"
                                    SelectionMode="None"
                                    IsItemClickEnabled="True"
                                    ItemClick="LanguageListView_ItemClick"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="UseSystemFocusVisuals" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <ListViewItemPresenter
                                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            Padding="{TemplateBinding Padding}"
                                                            SelectionCheckMarkVisualEnabled="False"
                                                            PointerOverBackground="Transparent"
                                                            PressedBackground="Transparent"
                                                            SelectedBackground="Transparent"
                                                            SelectedPointerOverBackground="Transparent"
                                                            SelectedPressedBackground="Transparent" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel
                            x:Name="LicenseStepPanel"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.CurrentStep, Mode=OneWay, Converter={StaticResource EqualValueToVisibility}, ConverterParameter=2}">
                            <TextBlock Text="{x:Bind ViewModel.StepLicenseTitle, Mode=OneWay}" Style="{StaticResource OobeStepTitleStyle}" />
                            <Border
                                Padding="16,14"
                                CornerRadius="10"
                                Height="240"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.LegalNoticeText, Mode=OneWay}"
                                        FontSize="13"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource ArdelInkBrush}" />
                                </ScrollViewer>
                            </Border>
                            <TextBlock
                                Text="{x:Bind ViewModel.OfficialPurchaseEncourageText, Mode=OneWay}"
                                FontSize="12"
                                Opacity="0.75"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <CheckBox
                                Content="{x:Bind ViewModel.StepLicenseAgree, Mode=OneWay}"
                                IsChecked="{x:Bind ViewModel.LicenseAccepted, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel
                            x:Name="ThemeStepPanel"
                            Spacing="20"
                            MaxWidth="760"
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.CurrentStep, Mode=OneWay, Converter={StaticResource EqualValueToVisibility}, ConverterParameter=3}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.StepThemeTitle, Mode=OneWay}" Style="{StaticResource OobeStepTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.StepThemeSubtitle, Mode=OneWay}" Style="{StaticResource OobeStepSubtitleStyle}" />
                            </StackPanel>
                            <ScrollViewer
                                MaxHeight="420"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Auto"
                                HorizontalScrollMode="Disabled">
                                <ItemsRepeater
                                    x:Name="ThemeOptionsRepeater"
                                    ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                                    ItemTemplate="{StaticResource OobeThemeCardTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            MinColumnSpacing="12"
                                            MinRowSpacing="12"
                                            MaximumRowsOrColumns="3"
                                            ItemsJustification="Start"
                                            ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedThemeDescription, Mode=OneWay}"
                                Style="{StaticResource OobeThemeHintStyle}" />
                        </StackPanel>

                        <StackPanel
                            x:Name="TutorialStepPanel"
                            Spacing="24"
                            MaxWidth="720"
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.CurrentStep, Mode=OneWay, Converter={StaticResource EqualValueToVisibility}, ConverterParameter=4}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.TutorialTitle, Mode=OneWay}" Style="{StaticResource OobeStepTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.TutorialSubtitle, Mode=OneWay}" Style="{StaticResource OobeStepSubtitleStyle}" />
                            </StackPanel>
                            <ScrollViewer
                                MaxHeight="420"
                                VerticalScrollBarVisibility="Hidden"
                                VerticalScrollMode="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled">
                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.TutorialSteps, Mode=OneWay}"
                                    ItemTemplate="{StaticResource OobeTutorialStepTemplate}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="0" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel
                            x:Name="CompleteStepPanel"
                            Spacing="20"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.CurrentStep, Mode=OneWay, Converter={StaticResource EqualValueToVisibility}, ConverterParameter=5}">
                            <FontIcon
                                x:Name="AnimCompleteCheck"
                                Glyph="&#xE73E;"
                                FontSize="72"
                                Foreground="{ThemeResource ArdelAccentBrush}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.StepCompleteTitle, Mode=OneWay}"
                                Style="{StaticResource OobeStepTitleStyle}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.StepCompleteSubtitle, Mode=OneWay}"
                                Style="{StaticResource OobeStepSubtitleStyle}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid
                x:Name="WelcomePanel"
                Visibility="{x:Bind ViewModel.IsWelcomeStep, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Spacing="20" HorizontalAlignment="Center" MaxWidth="520">
                    <Image
                        x:Name="WelcomeLogo"
                        Width="120"
                        Height="120"
                        HorizontalAlignment="Center"
                        Source="ms-appx:///Assets/ardel-logo.png" />
                    <TextBlock
                        Text="{x:Bind ViewModel.StepWelcomeTitle, Mode=OneWay}"
                        Style="{StaticResource OobeStepTitleStyle}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.StepWelcomeSubtitle, Mode=OneWay}"
                        Style="{StaticResource OobeStepSubtitleStyle}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Right">
                <Button
                    Content="{x:Bind ViewModel.PreviousLabel, Mode=OneWay}"
                    Style="{StaticResource OobeFooterButtonStyle}"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button
                    Content="{x:Bind ViewModel.NextButtonText, Mode=OneWay}"
                    Style="{StaticResource OobePrimaryButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    Command="{x:Bind ViewModel.GoNextCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
