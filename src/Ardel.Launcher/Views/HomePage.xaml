<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.HomePage"
    x:Name="HomeRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Ardel.Launcher.Localization"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="52,36,52,36" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: Ambient Top Bar (Weather) -->
            <RowDefinition Height="*" />     <!-- 1: Pure Canvas: Centered Greeting & Bottom-Right Launch CTA -->
        </Grid.RowDefinitions>

        <!-- Row 0: Ambient Top Indicators (Update Banner on Left, Weather on Right) -->
        <Grid Grid.Row="0">
            <!-- Left: Update Banner -->
            <Border
                x:Name="UpdateBanner"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ArdelAccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,6"
                Visibility="{x:Bind ViewModel.ShowUpdateBanner, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="{ThemeResource ArdelAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.UpdateBannerTitle, Mode=OneWay}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <Button
                        Style="{ThemeResource AccentButtonStyle}"
                        Padding="12,4"
                        MinHeight="28"
                        Command="{x:Bind ViewModel.ApplyUpdateCommand}"
                        IsEnabled="{x:Bind ViewModel.CanApplyUpdate, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay}"
                                Width="12"
                                Height="12"
                                Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{x:Bind ViewModel.UpdateActionLabel, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Style="{StaticResource ArdelIconButtonStyle}"
                        Padding="4"
                        Command="{x:Bind ViewModel.OpenReleaseNotesCommand}"
                        Visibility="{x:Bind ViewModel.HasReleaseNotes, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon Glyph="&#xE8A7;" FontSize="11" Opacity="0.75" />
                    </Button>
                    <Button
                        Style="{StaticResource ArdelIconButtonStyle}"
                        Padding="4"
                        Command="{x:Bind ViewModel.DismissUpdateBannerCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Opacity="0.6" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right: Weather -->
            <StackPanel
                x:Name="WeatherPanel"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="7"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.ShowWeatherWidget, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon
                    Glyph="{x:Bind ViewModel.WeatherGlyph, Mode=OneWay}"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="15"
                    Foreground="{ThemeResource ArdelAccentBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.WeatherTemperature, Mode=OneWay}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.WeatherCondition, Mode=OneWay}"
                    FontSize="12"
                    Opacity="0.75"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Row 1: Pure Canvas (Center Floating 3D Character, Bottom-Left Greeting, Bottom-Right Launch) -->
        <Grid Grid.Row="1" SizeChanged="Canvas_SizeChanged">
            <!-- Background Decorative: Dot Matrix Grid Canvas (Option 2) -->
            <Canvas
                x:Name="DotMatrixCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Opacity="0.09"
                IsHitTestVisible="False" />

            <!-- Bottom-Left: Grand Poetic Greeting (Bold Poster Baseline Anchor) -->
            <TextBlock
                x:Name="GreetingText"
                Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                FontSize="60"
                FontWeight="Bold"
                Foreground="{ThemeResource ArdelInkBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="4,0,0,8"
                TextLineBounds="Tight" />

            <!-- Bottom-Right: Last Played Instance Card + Launch Game Button -->
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Spacing="12"
                Margin="0,0,4,8"
                MaxWidth="320">

                <!-- Last Played Instance Card (Clickable to launch directly) -->
                <Button
                    Command="{x:Bind ViewModel.LaunchQuickCommand}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.ShowQuickLaunchCard, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <!-- Instance Icon Box -->
                        <Border
                            Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                            <Grid>
                                <!-- Custom Icon Image (from icon.png / pack) -->
                                <Image
                                    Source="{x:Bind ViewModel.SelectedInstanceIconImage, Mode=OneWay}"
                                    Stretch="UniformToFill"
                                    Visibility="{x:Bind ViewModel.HasCustomInstanceIcon, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <!-- Glyph Fallback -->
                                <FontIcon
                                    Glyph="{x:Bind ViewModel.SelectedInstanceIconGlyph, Mode=OneWay}"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="18"
                                    Foreground="{ThemeResource ArdelAccentBrush}"
                                    Visibility="{x:Bind ViewModel.HasCustomInstanceIcon, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Border>

                        <!-- Instance Metadata -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="{loc:String Key=InstanceSettings_StatsLastPlayed}"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Opacity="0.55" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.InstanceLastPlayed, Mode=OneWay}"
                                    FontSize="10"
                                    Opacity="0.75"
                                    Visibility="{x:Bind ViewModel.HasLastPlayed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedInstanceDisplayName, Mode=OneWay}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedInstanceKindLabel, Mode=OneWay}"
                                    FontSize="11"
                                    Opacity="0.65" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.InstanceTotalPlayTime, Mode=OneWay}"
                                    FontSize="11"
                                    Opacity="0.5"
                                    Visibility="{x:Bind ViewModel.HasPlayTime, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Play / Launch Indicator -->
                        <Border
                            Grid.Column="2"
                            Width="26"
                            Height="26"
                            CornerRadius="13"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            Margin="4,0,2,0">
                            <FontIcon
                                Glyph="&#xE768;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{ThemeResource ArdelAccentBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Single Launch Game Button & Progress -->
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="36,12"
                    CornerRadius="22"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.LaunchQuickCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="{loc:String Key=Home_LaunchGame}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Launch Progress Bar & Status Feedback -->
                <StackPanel
                    Spacing="4"
                    Width="180"
                    HorizontalAlignment="Right"
                    Visibility="{x:Bind ViewModel.IsLaunching, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar
                        IsIndeterminate="{x:Bind ViewModel.IsLaunchIndeterminate, Mode=OneWay}"
                        Value="{x:Bind ViewModel.LaunchProgressValue, Mode=OneWay}"
                        Maximum="100" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LaunchStatusText, Mode=OneWay}"
                        FontSize="11"
                        Opacity="0.75"
                        HorizontalAlignment="Right" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
