<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ardel.Launcher.Views.HomePage"
    x:Name="HomeRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Ardel.Launcher.Localization"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="52,36,52,36" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: Ambient Top Bar (Date, Weather, Clock, Voice) -->
            <RowDefinition Height="*" />     <!-- 1: Pure Canvas: Centered Greeting & Bottom-Right Launch CTA -->
        </Grid.RowDefinitions>

        <!-- Row 0: Ambient Top Indicators (Weather + Voice Assistant) -->
        <Grid Grid.Row="0">
            <!-- Right: Weather + Voice Assistant -->
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Weather info -->
                <StackPanel
                    x:Name="WeatherPanel"
                    Orientation="Horizontal"
                    Spacing="7"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ShowWeatherWidget, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon
                        Glyph="{x:Bind ViewModel.WeatherGlyph, Mode=OneWay}"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Foreground="{ThemeResource ArdelAccentBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.WeatherTemperature, Mode=OneWay}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.WeatherCondition, Mode=OneWay}"
                        FontSize="12"
                        Opacity="0.75"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- Voice Card Button -->
                <Button
                    Padding="10,5"
                    CornerRadius="8"
                    Click="VoiceCard_Click"
                    ToolTipService.ToolTip="{loc:String Key=Home_VoiceCardTitle}"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource ArdelAccentBrush}" />
                        <TextBlock Text="{loc:String Key=Home_VoiceCardTitle}" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Pure Canvas (Center Floating 3D Character, Bottom-Left Greeting, Bottom-Right Launch) -->
        <Grid Grid.Row="1" SizeChanged="Canvas_SizeChanged">
            <!-- Background Decorative: Dot Matrix Grid Canvas (Option 2) -->
            <Canvas
                x:Name="DotMatrixCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Opacity="0.09"
                IsHitTestVisible="False" />

            <!-- Bottom-Left: Grand Poetic Greeting (Bold Poster Baseline Anchor) -->
            <TextBlock
                x:Name="GreetingText"
                Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                FontSize="60"
                FontWeight="Bold"
                Foreground="{ThemeResource ArdelInkBrush}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="4,0,0,8"
                TextLineBounds="Tight" />

            <!-- Bottom-Right: Single Launch Game Button & Progress -->
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Spacing="8"
                Margin="0,0,4,8">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="36,12"
                    CornerRadius="22"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.LaunchQuickCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        <TextBlock Text="{loc:String Key=Home_LaunchGame}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Launch Progress Bar & Status Feedback -->
                <StackPanel
                    Spacing="4"
                    Width="180"
                    HorizontalAlignment="Right"
                    Visibility="{x:Bind ViewModel.IsLaunching, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar
                        IsIndeterminate="{x:Bind ViewModel.IsLaunchIndeterminate, Mode=OneWay}"
                        Value="{x:Bind ViewModel.LaunchProgressValue, Mode=OneWay}"
                        Maximum="100" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LaunchStatusText, Mode=OneWay}"
                        FontSize="11"
                        Opacity="0.75"
                        HorizontalAlignment="Right" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
